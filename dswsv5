// @description  可移动悬浮球 + 中英互译 + 英语长难句分析
// @match        http://*/*
// @match        https://*/*
// @grant        GM_xmlhttpRequest
// @grant        GM_getValue
// @grant        GM_setValue
// @connect      api.openclawplan.com
// @run-at       document-idle
// ==/UserScript==

(() => {
    'use strict';

    // =========================================================
    // 基础配置
    // =========================================================

    const DEFAULT_BASE_URL =
        'https://api.openclawplan.com/v1';

    const DEFAULT_MODEL =
        'gpt-5.6-terra';

    let currentText = '';
    let lastResult = '';
    let hideTimer = null;

    function getConfig() {
        return {
            apiKey:
                GM_getValue(
                    'translator_api_key',
                    ''
                ),

            baseUrl:
                GM_getValue(
                    'translator_base_url',
                    DEFAULT_BASE_URL
                ),

            model:
                GM_getValue(
                    'translator_model',
                    DEFAULT_MODEL
                )
        };
    }

    function saveConfig(
        apiKey,
        baseUrl,
        model
    ) {
        GM_setValue(
            'translator_api_key',
            apiKey.trim()
        );

        GM_setValue(
            'translator_base_url',
            (
                baseUrl.trim() ||
                DEFAULT_BASE_URL
            ).replace(/\/+$/, '')
        );

        GM_setValue(
            'translator_model',
            model.trim() ||
            DEFAULT_MODEL
        );
    }

    // =========================================================
    // 语言判断
    // =========================================================

    function detectLanguage(text) {
        const zhCount =
            (
                text.match(
                    /[\u4e00-\u9fff]/g
                ) || []
            ).length;

        const enCount =
            (
                text.match(
                    /[A-Za-z]/g
                ) || []
            ).length;

        if (
            zhCount === 0 &&
            enCount === 0
        ) {
            return 'unknown';
        }

        if (
            zhCount > 0 &&
            enCount === 0
        ) {
            return 'zh';
        }

        if (
            enCount > 0 &&
            zhCount === 0
        ) {
            return 'en';
        }

        const total =
            zhCount + enCount;

        if (
            zhCount / total >= 0.6
        ) {
            return 'zh';
        }

        if (
            enCount / total >= 0.6
        ) {
            return 'en';
        }

        return 'mixed';
    }

    // =========================================================
    // 获取选中文字
    // =========================================================

    function getSelectedText() {
        const active =
            document.activeElement;

        if (
            active &&
            (
                active.tagName ===
                    'TEXTAREA' ||
                active.tagName ===
                    'INPUT'
            )
        ) {
            const start =
                active.selectionStart;

            const end =
                active.selectionEnd;

            if (
                typeof start ===
                    'number' &&
                typeof end ===
                    'number' &&
                end > start
            ) {
                return active.value
                    .slice(
                        start,
                        end
                    )
                    .trim();
            }
        }

        return window
            .getSelection()
            .toString()
            .trim();
    }

    // =========================================================
    // API 输出解析
    // =========================================================

    function extractOutput(data) {
        if (!data) {
            return '';
        }

        if (
            typeof data.output_text ===
            'string'
        ) {
            return data.output_text.trim();
        }

        if (
            Array.isArray(
                data.output
            )
        ) {
            const result = [];

            for (
                const item
                of data.output
            ) {
                if (
                    !Array.isArray(
                        item.content
                    )
                ) {
                    continue;
                }

                for (
                    const content
                    of item.content
                ) {
                    if (
                        typeof content.text ===
                        'string'
                    ) {
                        result.push(
                            content.text
                        );
                    }

                    else if (
                        content.text &&
                        typeof
                            content.text.value ===
                            'string'
                    ) {
                        result.push(
                            content.text.value
                        );
                    }
                }
            }

            return result
                .join('\n')
                .trim();
        }

        return '';
    }

    // =========================================================
    // API 请求
    // =========================================================

    function requestAPI(prompt) {
        const config =
            getConfig();

        return new Promise(
            (
                resolve,
                reject
            ) => {

                if (
                    !config.apiKey
                ) {
                    reject(
                        new Error(
                            '请先点击设置按钮填写 API Key。'
                        )
                    );
                    return;
                }

                const url =
                    config.baseUrl
                        .replace(
                            /\/+$/,
                            ''
                        ) +
                    '/responses';

                GM_xmlhttpRequest({
                    method:
                        'POST',

                    url,

                    headers: {
                        'Content-Type':
                            'application/json',

                        'Authorization':
                            'Bearer ' +
                            config.apiKey
                    },

                    data:
                        JSON.stringify({
                            model:
                                config.model,

                            reasoning: {
                                effort:
                                    'low'
                            },

                            store:
                                false,

                            input:
                                prompt
                        }),

                    timeout:
                        60000,

                    onload(
                        response
                    ) {
                        let data;

                        try {
                            data =
                                JSON.parse(
                                    response
                                        .responseText
                                );
                        }
                        catch {
                            reject(
                                new Error(
                                    'API 返回内容不是有效 JSON。'
                                )
                            );
                            return;
                        }

                        if (
                            response.status <
                                200 ||
                            response.status >=
                                300
                        ) {
                            const message =
                                data?.error
                                    ?.message ||
                                data?.message ||
                                'HTTP ' +
                                    response
                                        .status;

                            reject(
                                new Error(
                                    message
                                )
                            );

                            return;
                        }

                        const output =
                            extractOutput(
                                data
                            );

                        if (!output) {
                            reject(
                                new Error(
                                    'API 返回成功，但没有找到文本结果。'
                                )
                            );

                            return;
                        }

                        resolve(
                            output
                        );
                    },

                    onerror() {
                        reject(
                            new Error(
                                '网络请求失败。'
                            )
                        );
                    },

                    ontimeout() {
                        reject(
                            new Error(
                                'API 请求超时。'
                            )
                        );
                    }
                });
            }
        );
    }

    // =========================================================
