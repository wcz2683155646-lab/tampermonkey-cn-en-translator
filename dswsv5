    <div id="ai-settings">

        <div class="ai-setting-title">
            ⚙ API 设置
        </div>

        <label>
            API Key
        </label>

        <input
            id="ai-api-key"
            type="password"
            placeholder="请输入 API Key"
        >


        <label>
            Base URL
        </label>

        <input
            id="ai-base-url"
            type="text"
        >


        <label>
            模型
        </label>

        <input
            id="ai-model"
            type="text"
        >


        <div
            class="ai-setting-actions"
        >

            <button
                class="ai-cancel"
                id="ai-cancel"
            >
                取消
            </button>

            <button
                class="ai-save"
                id="ai-save"
            >
                保存设置
            </button>

        </div>

    </div>

</div>


<div id="ai-translator-ball">

    <div class="ai-ball-inner">

        <div class="ai-ball-main">
            A译
        </div>

        <div class="ai-ball-sub">
            AI
        </div>

    </div>

</div>
`;

    document.body
        .appendChild(
            container
        );

    // =========================================================
    // 元素
    // =========================================================

    const ball =
        document.getElementById(
            'ai-translator-ball'
        );

    const panel =
        document.getElementById(
            'ai-translator-panel'
        );

    const content =
        document.getElementById(
            'ai-content'
        );

    const statusText =
        document.getElementById(
            'ai-status-text'
        );

    const settingsPanel =
        document.getElementById(
            'ai-settings'
        );

    // =========================================================
    // 初始悬浮球位置
    // =========================================================

    const savedX =
        GM_getValue(
            'translator_ball_x',
            window.innerWidth - 90
        );

    const savedY =
        GM_getValue(
            'translator_ball_y',
            Math.round(
                window.innerHeight *
                0.35
            )
        );

    function setContainerPosition(
        x,
        y
    ) {
        const maxX =
            window.innerWidth - 58;

        const maxY =
            window.innerHeight - 58;

        x =
            Math.max(
                0,
                Math.min(
                    x,
                    maxX
                )
            );

        y =
            Math.max(
                0,
                Math.min(
                    y,
                    maxY
                )
            );

        container.style.left =
            x + 'px';

        container.style.top =
            y + 'px';

        container.style.right =
            'auto';

        return {
            x,
            y
        };
    }

    setContainerPosition(
        savedX,
        savedY
    );

    // =========================================================
    // 自动决定面板向左还是向右展开
    // =========================================================

    function updatePanelDirection() {
        const rect =
            ball.getBoundingClientRect();

        const panelWidth =
            420;

        if (
            rect.left >
            panelWidth + 30
        ) {
            panel.style.right =
                '68px';

            panel.style.left =
                'auto';
        }

        else {
            panel.style.left =
                '68px';

            panel.style.right =
                'auto';
        }

        const panelHeight =
            Math.min(
                window.innerHeight *
                    0.5,
                560
            );

        if (
            rect.top +
                panelHeight >
            window.innerHeight
        ) {
            panel.style.top =
                'auto';

            panel.style.bottom =
                '0';
        }

        else {
            panel.style.top =
                '0';

            panel.style.bottom =
                'auto';
        }
    }

    // =========================================================
    // 悬浮球 hover
    // =========================================================

    function openPanel() {
        clearTimeout(
            hideTimer
        );

        updatePanelDirection();

        container
            .classList
            .add(
                'ai-open'
            );
    }

    function scheduleClose() {
        clearTimeout(
            hideTimer
        );

        hideTimer =
            setTimeout(
                () => {

                    if (
                        settingsPanel
                            .style
                            .display ===
                        'block'
                    ) {
                        return;
                    }

                    container
                        .classList
                        .remove(
                            'ai-open'
                        );

                },
                280
            );
    }

    ball.addEventListener(
        'mouseenter',
        openPanel
    );

    ball.addEventListener(
        'mouseleave',
        scheduleClose
    );

    panel.addEventListener(
        'mouseenter',
        openPanel
    );

    panel.addEventListener(
        'mouseleave',
        scheduleClose
    );

    // =========================================================
    // 拖动悬浮球
    // =========================================================

    let dragging =
        false;

    let startMouseX =
        0;

    let startMouseY =
        0;

    let startX =
        0;

    let startY =
        0;

    let moved =
        false;

    ball.addEventListener(
        'mousedown',
        e => {

            if (
                e.button !== 0
            ) {
                return;
            }

            dragging =
                true;

            moved =
                false;

            startMouseX =
                e.clientX;

            startMouseY =
                e.clientY;

            const rect =
                container
                    .getBoundingClientRect();

            startX =
                rect.left;

            startY =
                rect.top;

            e.preventDefault();
        }
    );

    document.addEventListener(
        'mousemove',
        e => {

            if (
                !dragging
            ) {
                return;
            }

            const dx =
                e.clientX -
                startMouseX;

            const dy =
                e.clientY -
                startMouseY;

            if (
                Math.abs(dx) > 3 ||
                Math.abs(dy) > 3
            ) {
                moved =
                    true;
            }

            const position =
                setContainerPosition(
                    startX + dx,
                    startY + dy
                );

            updatePanelDirection();

            GM_setValue(
                'translator_ball_x',
                position.x
            );

            GM_setValue(
                'translator_ball_y',
                position.y
            );
        }
    );

    document.addEventListener(
        'mouseup',
        () => {

            if (
                !dragging
            ) {
                return;
            }

            dragging =
                false;

            ball.style.cursor =
                'grab';
        }
    );

    // =========================================================
    // 状态
    // =========================================================

    function setStatus(text) {
        statusText.textContent =
            text;
    }

    // =========================================================
    // 卡片显示
    // =========================================================

    function showResult(
        original,
        title,
        result
    ) {
        lastResult =
            result;

        content.innerHTML =
            '';

        const originalCard =
            document.createElement(
                'div'
            );

        originalCard.className =
            'ai-card ai-card-original';

        originalCard.innerHTML = `

<div class="ai-label">

    <span
        class="ai-dot
        ai-dot-blue"
    ></span>

    原文

</div>

<div
    class="ai-text"
></div>
`;

        originalCard
            .querySelector(
                '.ai-text'
            )
            .textContent =
                original;

        const resultCard =
            document.createElement(
                'div'
            );

        resultCard.className =
            'ai-card ai-card-result';

        resultCard.innerHTML = `

<div class="ai-label">

    <span
        class="ai-dot
        ai-dot-purple"
    ></span>

    <span
        class="ai-result-title"
    ></span>

</div>

<div
    class="ai-text"
></div>
`;

        resultCard
            .querySelector(
                '.ai-result-title'
            )
            .textContent =
                title;

        resultCard
            .querySelector(
                '.ai-text'
            )
            .textContent =
                result;

        content.appendChild(
            originalCard
        );

        content.appendChild(
            resultCard
        );
    }

    // =========================================================
    // 翻译
    // =========================================================

    async function translate() {
        const text =
            getSelectedText();

        if (!text) {
            setStatus(
                '请先选择中文或英文'
            );

            openPanel();

            return;
        }

        currentText =
            text;

        const lang =
            detectLanguage(
                text
            );

        if (
            lang !== 'zh' &&
            lang !== 'en'
        ) {
            setStatus(
                '仅支持中文和英文互译'
            );

            openPanel();

            return;
        }

        openPanel();

        setStatus(
            lang === 'zh'
                ? '正在翻译：中文 → 英文…'
                : '正在翻译：英文 → 中文…'
        );

        content.innerHTML = `

<div class="ai-card">

    <div class="ai-label">
        ✦ AI 正在思考
    </div>

    <div class="ai-text">
        正在生成翻译结果，请稍候…
    </div>

</div>
`;

        try {
            const result =
                await requestAPI(
                    createTranslatePrompt(
                        text,
                        lang
                    )
                );

            showResult(
                text,

                lang === 'zh'
                    ? '英文翻译'
                    : '中文翻译',

                result
            );

            setStatus(
                '✓ 翻译完成'
            );
        }

        catch (error) {
            setStatus(
                '错误：' +
                error.message
            );

            content.innerHTML = `

<div
    class="ai-card
    ai-card-result"
>

    <div class="ai-label">
        请求失败
    </div>

    <div class="ai-text"></div>

</div>
`;

            content
                .querySelector(
                    '.ai-text'
                )
                .textContent =
                    error.message;
        }
    }

    // =========================================================
    // 长难句
    // =========================================================

    async function analyze() {
        let text =
            getSelectedText();

        if (!text) {
            text =
                currentText;
        }

        if (!text) {
            setStatus(
                '请先选择英文句子'
            );

            return;
        }

        if (
            detectLanguage(
                text
            ) !== 'en'
        ) {
            setStatus(
                '长难句分析仅支持英文'
            );

            return;
        }

        currentText =
            text;

        openPanel();

        setStatus(
            '正在分析英语句子结构…'
        );

        content.innerHTML = `

<div class="ai-card">

    <div class="ai-label">
        ◈ 长难句分析
    </div>

    <div class="ai-text">
        正在分析主干、从句、修饰关系和重点词组…
    </div>

</div>
`;

        try {
            const result =
                await requestAPI(
                    createAnalysisPrompt(
                        text
                    )
                );

            showResult(
                text,
                '长难句结构分析',
                result
            );

            setStatus(
                '✓ 长难句分析完成'
            );
        }

        catch (error) {
            setStatus(
                '错误：' +
                error.message
            );
        }
    }

    // =========================================================
    // 设置
    // =========================================================

    document
        .getElementById(
            'ai-settings-btn'
        )
        .addEventListener(
            'click',
            e => {

                e.stopPropagation();

                const config =
                    getConfig();

                document
                    .getElementById(
                        'ai-api-key'
                    )
                    .value =
                        config.apiKey;

                document
                    .getElementById(
                        'ai-base-url'
                    )
                    .value =
                        config.baseUrl;

                document
                    .getElementById(
                        'ai-model'
                    )
                    .value =
                        config.model;

                settingsPanel
                    .style
                    .display =
                        'block';

                openPanel();
            }
        );

    document
        .getElementById(
            'ai-cancel'
        )
        .addEventListener(
            'click',
            () => {

                settingsPanel
                    .style
                    .display =
                        'none';
            }
        );

    document
        .getElementById(
            'ai-save'
        )
        .addEventListener(
            'click',
            () => {

                const apiKey =
                    document
                        .getElementById(
                            'ai-api-key'
                        )
                        .value;

                const baseUrl =
                    document
                        .getElementById(
                            'ai-base-url'
                        )
                        .value;

                const model =
                    document
                        .getElementById(
                            'ai-model'
                        )
                        .value;

                if (
                    !apiKey.trim()
                ) {
                    setStatus(
                        'API Key 不能为空'
                    );

                    return;
                }

                saveConfig(
                    apiKey,
                    baseUrl,
                    model
                );

                settingsPanel
                    .style
                    .display =
                        'none';

                setStatus(
                    '✓ API 设置已保存'
                );
            }
        );

    // =========================================================
    // 按钮
    // =========================================================

    document
        .getElementById(
            'ai-translate'
        )
        .addEventListener(
            'click',
            translate
        );

    document
        .getElementById(
            'ai-analysis'
        )
        .addEventListener(
            'click',
            analyze
        );

    document
        .getElementById(
            'ai-copy'
        )
        .addEventListener(
            'click',
            async () => {

                if (!lastResult) {
                    setStatus(
                        '当前没有结果可复制'
                    );

                    return;
                }

                try {
                    await navigator
                        .clipboard
                        .writeText(
                            lastResult
                        );

                    setStatus(
                        '✓ 已复制到剪贴板'
                    );
                }

                catch {
                    setStatus(
                        '复制失败，请手动复制'
                    );
                }
            }
        );

    document
        .getElementById(
            'ai-clear'
        )
        .addEventListener(
            'click',
            () => {

                currentText =
                    '';

                lastResult =
                    '';

                content.innerHTML = `

<div class="ai-card">

    <div class="ai-label">
        已清空
    </div>

    <div class="ai-text">
        选择中文或英文后按 Alt + T 开始翻译。
    </div>

</div>
`;

                setStatus(
                    '准备就绪'
                );
            }
        );

    // =========================================================
    // Alt + T
    // =========================================================

    document.addEventListener(
        'keydown',
        event => {

            if (
                event.altKey &&
                !event.ctrlKey &&
                !event.shiftKey &&
                !event.metaKey &&
                event.key
                    .toLowerCase() ===
                    't'
            ) {
                event
                    .preventDefault();

                translate();
            }
        },
        true
    );

    // =========================================================
    // 窗口尺寸发生变化
    // =========================================================

    window.addEventListener(
        'resize',
        () => {

            const rect =
                container
                    .getBoundingClientRect();

            const position =
                setContainerPosition(
                    rect.left,
                    rect.top
                );

            GM_setValue(
                'translator_ball_x',
                position.x
            );

            GM_setValue(
                'translator_ball_y',
                position.y
            );
        }
    );

})();
