    async function pureTranslateText(text) {
        if (requestBusy) {
            setStatus('当前已有请求正在处理中', 'working');
            return;
        }
        const lang = detectLanguage(text);
        if (!text || (lang !== 'zh' && lang !== 'en')) {
            setStatus('请输入中文或英文内容', 'error');
            return;
        }
        requestBusy = true;
        currentText = text;
        openPanel();
        setStatus(lang === 'zh' ? '正在翻译：中文 → 英文…' : '正在翻译：英文 → 中文…', 'working');
        content.innerHTML = '<div class="ai-card"><div class="ai-label">纯翻译</div><div class="ai-text">正在生成翻译结果…</div></div>';
        lastRequest = () => pureTranslateText(text);
        try {
            const result = await requestAPI(pureTranslationPrompt(text, lang), NORMAL_TIMEOUT);
            showResult(text, lang === 'zh' ? '英文翻译' : '中文翻译', result);
            setStatus('翻译完成', 'success');
        } catch (error) {
            if (isCancelledError(error)) return;
            setStatus('翻译失败：' + error.message, 'error');
            showError('翻译失败', error.message === 'TIMEOUT' ? 'API 请求超时，请稍后重试。' : error.message);
        } finally {
            requestBusy = false;
        }
    }

