    async function detailedAnalyze(forcedText = '') {
        if (requestBusy) {
            setStatus(
                '当前已有请求正在处理中',
                'working'
            );
            return;
        }

        const text = forcedText || await getSentenceAnalysisText();

        if (!text) {
            setStatus(
                '请先选择英文，或点击 📋 读取剪贴板',
                'error'
            );

            openPanel();

            return;
        }

        if (
            detectLanguage(text) !==
            'en'
        ) {
            setStatus(
                '详细分析仅支持英文',
                'error'
            );

            openPanel();

            return;
        }

        currentText = text;
        requestBusy = true;
        lastRequest = () => detailedAnalyze(text);

        openPanel();

        setStatus(
            '正在详细分析，可能需要一些时间…',
            'working'
        );

        content.innerHTML = `
<div class="ai-card">
    <div class="ai-label">
        详细分析
    </div>

    <div class="ai-text">
        正在分析主干、从句、修饰关系、重点词组和翻译…
    </div>
</div>
`;

        try {
            const result =
                await requestAPI(
                    detailPrompt(text),
                    DETAIL_TIMEOUT
                );

            showResult(
                text,
                '详细分析',
                result
            );

            setStatus(
                '详细分析完成',
                'success'
            );

            requestBusy = false;
            return;
        } catch (error) {
            if (isCancelledError(error)) {
                requestBusy = false;
                return;
            }
            if (
                error.message !==
                'TIMEOUT'
            ) {
                setStatus(
                    '详细分析失败：' +
                    error.message,
                    'error'
                );

                showError(
                    '详细分析失败',
                    error.message
                );

                requestBusy = false;
                return;
            }
        }

        // 第一次超时，自动精简重试

        setStatus(
            '首次请求超时，正在自动精简重试…',
            'working'
        );

        content.innerHTML = `
<div class="ai-card">
    <div class="ai-label">
        自动重试
    </div>

    <div class="ai-text">
        首次详细分析超时，正在使用更精简的分析方式重新请求…
    </div>
</div>
`;

        try {
            const result =
                await requestAPI(
                    fallbackPrompt(text),
                    DETAIL_TIMEOUT
                );

            showResult(
                text,
                '详细分析（精简重试）',
                result
            );

            setStatus(
                '详细分析完成（重试成功）',
                'success'
            );
        } catch (error) {
            if (isCancelledError(error)) return;
            if (
