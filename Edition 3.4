    // =========================================================
    // 剪贴板读取
    // =========================================================

    async function readClipboardText() {
        try {
            const text =
                await navigator
                    .clipboard
                    .readText();

            if (!text.trim()) {
                setStatus(
                    '剪贴板中没有文本',
                    'error'
                );

                return '';
            }

            clipboardText =
                text.trim();
            currentText = clipboardText;

            clipboardTextLoaded = true;

            const translationInput = document.getElementById('ai-translation-input');
            if (translationInput) {
                translationInput.value = currentText;
            }

            showInputPreview(
                currentText
            );

            setStatus(
                '已读取剪贴板文本',
                'success'
            );

            return currentText;
        } catch {
            setStatus(
                '无法读取剪贴板，请检查浏览器剪贴板权限',
                'error'
            );

            return '';
        }
    }

    // =========================================================
    // 单词与短语翻译
    // =========================================================

    async function translateText(text, detail = false) {
        if (requestBusy) {
            setStatus(
                '当前已有请求正在处理中',
                'working'
            );
            return;
        }

        if (!text) {
            setStatus('请输入或粘贴需要查询的单词或短语', 'error');
            return;
        }

        currentText = text;

        const lang =
            detectLanguage(text);

        if (
            lang !== 'zh' &&
            lang !== 'en'
        ) {
            setStatus(
                '仅支持中文或英文单词、短语查询',
                'error'
            );

            openPanel();

            return;
        }

        requestBusy = true;
        lastRequest = () => translateText(text, detail);

        openPanel();

        setStatus(
            detail ? '正在生成详细词汇解析…' : '正在快速翻译词条…',
            'working'
        );

        content.innerHTML = `
<div class="ai-card">
    <div class="ai-label">
        ${detail ? '正在详细翻译' : '正在快速翻译'}
    </div>

    <div class="ai-text">
        AI 正在生成词条释义与用法…
    </div>
</div>
`;

        try {
            const result =
                await requestAPI(
                    vocabularyPrompt(text, detail),
                    NORMAL_TIMEOUT
                );

            showResult(
                text,
                detail ? '单词/短语详细翻译' : '单词/短语快速翻译',
                result
            );

            setStatus(
                detail ? '详细翻译完成' : '快速翻译完成',
                'success'
            );
        } catch (error) {
            if (isCancelledError(error)) return;
            if (
                error.message ===
                'TIMEOUT'
            ) {
                setStatus(
                    '翻译请求超时',
                    'error'
                );

                showError(
                    '翻译失败',
                    'API 请求超时，请稍后重试。'
                );
            } else {
                setStatus(
                    '请求失败：' +
                    error.message,
                    'error'
                );

                showError(
                    '翻译失败',
                    error.message
                );
            }
        } finally {
            requestBusy = false;
        }
    }

    // =========================================================
    // 快速分析
    // =========================================================

    async function quickAnalyze(forcedText = '') {
        if (requestBusy) {
            setStatus(
                '当前已有请求正在处理中',
                'working'
            );
            return;
        }

        const text = forcedText || await getSentenceAnalysisText();

        if (!text) {
            setStatus(
                '请先选择英文，或点击 📋 读取剪贴板',
                'error'
            );

            openPanel();

            return;
        }

        if (
            detectLanguage(text) !==
            'en'
        ) {
            setStatus(
                '快速分析仅支持英文',
                'error'
            );

            openPanel();

            return;
        }

        currentText = text;
        requestBusy = true;
