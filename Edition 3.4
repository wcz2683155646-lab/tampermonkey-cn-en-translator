// ==UserScript==
// @name         中英词汇助手 + 英语长难句分析 Pro
// @namespace    tampermonkey-cn-en-translator
// @version      2.5.2
// @description  单词短语翻译、词汇详解、英语长难句分析、剪贴板与状态动画
// @match        http://*/*
// @match        https://*/*
// @match        file:///*
// @grant        GM_xmlhttpRequest
// @grant        GM_getValue
// @grant        GM_setValue
// @connect      api.openclawplan.com
// @run-at       document-idle
// ==/UserScript==

(() => {
    'use strict';

    const DEFAULT_BASE_URL = 'https://api.openclawplan.com/v1';
    const DEFAULT_MODEL = 'gpt-5.6-terra';

    const NORMAL_TIMEOUT = 60000;
    const DETAIL_TIMEOUT = 180000;
    const ARTICLE_MAX_CHARS = 30000;

    const BALL_SIZE = 44;
    const PANEL_WIDTH = 420;
    const SCRIPT_VERSION = '2.5.2';

    let currentText = '';
    let clipboardText = '';
    let lastSelectedText = '';
    let copiedSelectionText = '';
    let lastResult = '';
    let panelOpen = false;
    let requestBusy = false;
    let clipboardTextLoaded = false;
    let lastRequest = null;
    const MAX_QUESTION_TURNS = 6;
    const MAX_HISTORY_TEXT_CHARS = 12000;
    const MAX_FAVORITES = 500;
    let activeRequest = null;
    let requestToken = 0;

    function loadQuestionHistory() {
        try {
            return loadQuestionHistoryFromValue(
                GM_getValue('translator_question_history', [])
            );
        } catch {
            return [];
        }
    }

    function loadVocabularyFavorites() {
        try {
            const value = GM_getValue('translator_vocabulary_favorites', []);
            if (!Array.isArray(value)) return [];
            return value
                .filter(item => item && typeof item.text === 'string' && item.text.trim())
                .map(item => ({
                    text: item.text.trim().slice(0, 500),
                    savedAt: Number(item.savedAt) || Date.now()
                }))
                .slice(0, MAX_FAVORITES);
        } catch {
            return [];
        }
    }

    let questionHistory = loadQuestionHistory();
    let vocabularyFavorites = loadVocabularyFavorites();

    function saveQuestionHistory() {
        questionHistory = loadQuestionHistoryFromValue(questionHistory);
        try {
            GM_setValue('translator_question_history', questionHistory);
        } catch (error) {
            console.error('保存问答历史失败', error);
        }
    }

    function loadQuestionHistoryFromValue(value) {
        if (!Array.isArray(value)) return [];
        return value
            .filter(item => item && typeof item.question === 'string' && typeof item.answer === 'string')
            .map(item => ({
                question: item.question.slice(0, MAX_HISTORY_TEXT_CHARS),
                answer: item.answer.slice(0, MAX_HISTORY_TEXT_CHARS)
            }))
            .slice(-MAX_QUESTION_TURNS);
    }

    function speakVocabulary(text) {
        if (!text || !('speechSynthesis' in window)) {
            setStatus('当前浏览器不支持朗读', 'error');
            return;
        }
        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = detectLanguage(text) === 'en' ? 'en-US' : 'zh-CN';
        window.speechSynthesis.speak(utterance);
        setStatus('正在朗读词条', 'success');
    }

    function toggleVocabularyFavorite(text) {
        const entry = text.trim();
        if (!entry) return;
        const index = vocabularyFavorites.findIndex(item => item.text === entry);
        if (index >= 0) {
            vocabularyFavorites.splice(index, 1);
            setStatus('已取消收藏', 'success');
        } else {
            vocabularyFavorites.unshift({ text: entry, savedAt: Date.now() });
            vocabularyFavorites = vocabularyFavorites.slice(0, MAX_FAVORITES);
            setStatus('已收藏词条', 'success');
        }
        try {
            GM_setValue('translator_vocabulary_favorites', vocabularyFavorites);
        } catch (error) {
            setStatus('收藏保存失败：' + error.message, 'error');
        }
        updateFavoriteButton();
    }

    function updateFavoriteButton() {
        const input = document.getElementById('ai-translation-input');
        const button = document.getElementById('ai-translation-favorite');
        if (!input || !button) return;
        const favorited = vocabularyFavorites.some(item => item.text === input.value.trim());
        button.classList.toggle('ai-favorited', favorited);
        button.textContent = favorited ? '★' : '☆';
    }

    function showVocabularyFavorites() {
        if (!vocabularyFavorites.length) {
            setStatus('还没有收藏词条', 'error');
            return;
        }
        content.innerHTML = '';
        const card = document.createElement('div');
        card.className = 'ai-card ai-card-result';
        card.innerHTML = '<div class="ai-label">收藏词条</div><div class="ai-text"></div>';
        card.querySelector('.ai-text').innerHTML = vocabularyFavorites
            .map((item, index) => `${index + 1}、<strong>${escapeHtml(item.text)}</strong>`)
            .join('<br>');
        content.appendChild(card);
        openPanel();
    }

    // =========================================================
    // API 配置
    // =========================================================

    function getConfig() {
        return {
            apiKey: GM_getValue('translator_api_key', ''),
            baseUrl: GM_getValue(
                'translator_base_url',
                DEFAULT_BASE_URL
            ),
            model: GM_getValue(
                'translator_model',
                DEFAULT_MODEL
            )
        };
    }

    function saveConfig(apiKey, baseUrl, model) {
        GM_setValue(
            'translator_api_key',
            apiKey.trim()
        );

        GM_setValue(
            'translator_base_url',
            (baseUrl.trim() || DEFAULT_BASE_URL)
                .replace(/\/+$/, '')
        );

        GM_setValue(
            'translator_model',
            model.trim() || DEFAULT_MODEL
        );
    }

    // =========================================================
    // 判断语言
    // =========================================================

    function detectLanguage(text) {
        text = String(text || '');

        const zh =
            (text.match(/[\u4e00-\u9fff]/g) || []).length;

        const en =
            (text.match(/[A-Za-z]/g) || []).length;

        if (!zh && !en) return 'unknown';
        if (zh && !en) return 'zh';
        if (en && !zh) return 'en';

        const total = zh + en;

        if (zh / total >= 0.6) return 'zh';
        if (en / total >= 0.6) return 'en';

        return 'mixed';
    }

    // =========================================================
    // 获取选中文字
    // =========================================================

    function getSelectedText() {
        const active = document.activeElement;

        // 插件自身输入框里的光标或局部选区不能作为网页分析文本。
        if (active && active.closest?.('#ai-translator-container')) {
            return '';
        }

        if (
            active &&
            (
                active.tagName === 'TEXTAREA' ||
                active.tagName === 'INPUT'
            )
        ) {
            const start = active.selectionStart;
            const end = active.selectionEnd;

            if (
                typeof start === 'number' &&
                typeof end === 'number' &&
                end > start
            ) {
                return active.value
                    .slice(start, end)
                    .trim();
            }
        }

        try {
            const selection = window.getSelection();
            const anchorElement = selection?.anchorNode?.nodeType === Node.ELEMENT_NODE
                ? selection.anchorNode
                : selection?.anchorNode?.parentElement;
            if (anchorElement?.closest?.('#ai-translator-container')) {
                return '';
            }
            return String(
                selection?.toString() || ''
            ).trim();
        } catch {
            return '';
        }
    }

    async function getSentenceAnalysisText() {
        // 用户点击“读取剪贴板”后，说明其明确希望分析完整复制内容。
        // 必须优先于页面中仍然残留的旧选区。
        if (clipboardTextLoaded && clipboardText) {
            return clipboardText.trim();
        }

        const selectedText = (
            getSelectedText() ||
            lastSelectedText ||
            copiedSelectionText ||
            ''
        ).trim();

        // PDF 阅读器或复杂网页可能只向 Selection API 暴露句子的一部分，
        // 但 Ctrl+C 后的剪贴板通常保留完整内容。仅当两者内容相关时取较长者，
        // 避免无关的旧剪贴板覆盖用户刚选中的句子。
        try {
            const clipboardValue = (await navigator.clipboard.readText()).trim();
            if (!clipboardValue) return selectedText;
            if (!selectedText) return clipboardValue;

            const normalize = value => value.replace(/\s+/g, ' ').trim().toLowerCase();
            const selectedNormalized = normalize(selectedText);
            const clipboardNormalized = normalize(clipboardValue);
            const related =
                clipboardNormalized.includes(selectedNormalized) ||
                selectedNormalized.includes(clipboardNormalized);

            if (related && clipboardValue.length > selectedText.length) {
                clipboardText = clipboardValue;
                clipboardTextLoaded = true;
                return clipboardValue;
            }
        } catch {
            // 剪贴板权限不可用时使用网页选区或缓存文本。
        }

        return selectedText;
    }

    async function getSelectedOrClipboardText() {
        const selected = (
            getSelectedText() ||
            lastSelectedText ||
            copiedSelectionText ||
            ''
        ).trim();
        try {
            const clipboardValue = (await navigator.clipboard.readText()).trim();
            if (!clipboardValue) return selected;
            if (!selected) return clipboardValue;

            const normalize = value => value.replace(/\s+/g, ' ').trim().toLowerCase();
            const selectedNormalized = normalize(selected);
            const clipboardNormalized = normalize(clipboardValue);
            const related =
                clipboardNormalized.includes(selectedNormalized) ||
                selectedNormalized.includes(clipboardNormalized);

            if (related && clipboardValue.length > selected.length) {
                lastSelectedText = clipboardValue;
                copiedSelectionText = clipboardValue;
                return clipboardValue;
            }
        } catch {
            // 剪贴板权限不可用时使用网页选区或复制事件缓存。
        }
        return selected;
    }

    // =========================================================
    // 清理输出格式
    // =========================================================

    function cleanResult(text) {
        return String(text || '')
            .replace(/\r\n/g, '\n')
            // 去掉模型常见的 Markdown 项目符号和装饰符号，保留文字内容
            .replace(/^\s*[-*+]\s+/gm, '')
            .replace(/^\s*#{1,6}\s+/gm, '')
            .replace(/[ \t]+\n/g, '\n')
            .replace(/\n[ \t]+\n/g, '\n')
            .replace(/\n{2,}/g, '\n')
            .trim();
    }

    function escapeHtml(text) {
        return String(text || '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function formatResult(text) {
        const escaped = escapeHtml(cleanResult(text));

        return escaped
            .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
            .replace(/__(.+?)__/g, '<u>$1</u>')
            .replace(/(^|[\s：:])\*([^*\n]+?)\*(?=\s|$)/g, '$1$2')
            .replace(/\n/g, '<br>');
    }

    // =========================================================
    // Responses API 解析
    // =========================================================

    function extractOutput(data) {
        if (!data) return '';

        if (
            typeof data.output_text === 'string'
        ) {
            return data.output_text.trim();
        }

        if (Array.isArray(data.output)) {
            const parts = [];

            for (const item of data.output) {
                if (!Array.isArray(item?.content)) {
                    continue;
                }

                for (const c of item.content) {
                    if (
                        typeof c?.text === 'string'
                    ) {
                        parts.push(c.text);
                    } else if (
                        c?.text &&
                        typeof c.text.value === 'string'
                    ) {
                        parts.push(c.text.value);
                    }
                }
            }

            return parts.join('\n').trim();
        }

        if (
            data.response &&
            typeof data.response.output_text === 'string'
        ) {
            return data.response.output_text.trim();
        }

        return '';
    }

    // =========================================================
    // API 请求
    // =========================================================

    function cancelActiveRequest() {
        requestToken += 1;
        const active = activeRequest;
        activeRequest = null;
        active?.xhr?.abort();
    }

    function isCancelledError(error) {
        return error?.message === '请求已取消';
    }

    function requestAPI(
        prompt,
        timeout = NORMAL_TIMEOUT
    ) {
        const config = getConfig();

        return new Promise((resolve, reject) => {
            if (!config.apiKey) {
                reject(new Error('请先在设置中填写 API Key'));
                return;
            }

            const token = ++requestToken;
            let settled = false;
            const finish = (handler, value) => {
                if (settled) return;
                settled = true;
                if (activeRequest?.token === token) activeRequest = null;
                handler(value);
            };
            const fail = error => finish(reject, error);
            const isCurrent = () => token === requestToken;
            const url = config.baseUrl.replace(/\/+$/, '') + '/responses';

            const xhr = GM_xmlhttpRequest({
                method: 'POST',
                url,
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': 'Bearer ' + config.apiKey
                },
                data: JSON.stringify({
                    model: config.model,
                    reasoning: { effort: 'low' },
                    store: false,
                    input: prompt
                }),
                timeout,
                onload(response) {
                    if (!isCurrent()) {
                        fail(new Error('请求已取消'));
                        return;
                    }
                    let data;
                    try {
                        data = JSON.parse(response.responseText);
                    } catch {
                        fail(new Error('API 返回内容不是有效 JSON'));
                        return;
                    }
                    if (response.status < 200 || response.status >= 300) {
                        fail(new Error(
                            data?.error?.message || data?.message || 'HTTP ' + response.status
                        ));
                        return;
                    }
                    const output = extractOutput(data);
                    if (!output) {
                        fail(new Error('API 返回成功，但没有找到文本结果'));
                        return;
                    }
                    finish(resolve, cleanResult(output));
                },
                onerror() {
                    fail(new Error('网络请求失败'));
                },
                ontimeout() {
                    fail(new Error('TIMEOUT'));
                },
                onabort() {
                    fail(new Error('请求已取消'));
                }
            });
            activeRequest = { token, xhr };
        });
    }

    // =========================================================
    // 单词与短语翻译 Prompt
    // =========================================================

    function vocabularyPrompt(text, detail = false) {
        const level = detail ? `
请严格按以下结构输出，各部分之间不留空行：
一、词条
1、给出原词或原短语、词性（如适用）和音标（英文词条适用）。
二、核心释义
1、给出最常用且准确的中文或英文对应表达。
2、存在多个常用词性或义项时，按常用程度列出，避免堆砌生僻义项。
三、用法
1、说明最重要的搭配、介词或语法限制。
2、给出 2 个简短、自然的双语例句。
四、派生串记
1、列出 2～5 个高价值同词根派生词，以“词 → 含义 → 与原词关系”的形式呈现。
2、若没有可靠派生词，明确写“无常用派生词”，不得编造。
五、近义词与反义词
1、列出 2～4 个常用近义词，并简述与原词的关键区别。
2、列出常用反义词；没有明确反义词时写“无固定反义词”。
六、词根词缀
1、拆解词根、前缀、后缀及其含义。
2、短语或不可可靠拆解的词条写“无适用词根词缀拆解”，不得牵强拆分。
` : `
请严格按以下结构输出，各部分之间不留空行：
一、核心翻译
1、给出最常用、最准确的对应表达。
二、常用用法
1、只列 1～3 个关键搭配或词性提示。
三、例句
1、给出 1 个简短自然的双语例句。
`;

        return `
你是一名严谨的中英词汇教师。请处理下面的单词或短语；若输入为中文，先给出最自然的英文对应词或短语；若输入为英文，给出准确的简体中文释义。
${level}
通用要求：
1. 只处理单词或短语，不按整句翻译方式展开。
2. 使用中文分级编号：一级“一、二、三”，二级“1、2、3”。
3. 重点英文词语、搭配或例句用 **加粗** 或 __下划线__ 标记。
4. 不使用项目符号、星号装饰、短横线列表、Markdown 表格或无关说明。
5. 内容准确、简洁、层级清晰；不确定的信息宁可省略，不得编造。
待查询词条：
${text}
`.trim();
    }

    function pureTranslationPrompt(text, lang) {
        return `
You are a professional Chinese-English translator.
Translate the following ${lang === 'zh' ? 'Chinese' : 'English'} text into ${lang === 'zh' ? 'natural, accurate English' : 'natural, accurate Simplified Chinese'}.
Requirements:
1. Return only the translation.
2. Preserve the original meaning, tone, names, numbers, paragraph breaks and punctuation.
3. Do not explain, analyze, summarize, add notes, add headings, or provide alternatives.
4. Do not perform vocabulary, grammar, sentence, or article analysis.
Text:
${text}
`.trim();
    }

    // =========================================================
    // 快速分析 Prompt
    // =========================================================

    function quickPrompt(text) {
        return `
你是一名英语老师。快速分析下面英文，只保留真正有助于理解的内容。
严格按以下格式输出，各部分之间不要空行：
一、句子主干
1、指出核心主谓宾或主系表。
二、关键结构
1、简洁说明最重要的从句、非谓语和修饰关系。
三、理解难点
1、列出 1～3 个最重要的词组、搭配或语法难点。
四、自然翻译
1、给出自然准确的简体中文翻译。
要求：
1. 不展开讲课。
2. 不重复原句。
3. 不解释简单词汇和简单语法。
4. 整体尽量控制在 250 个中文字以内。
5. 不使用 Markdown 表格。
6. 不加入空白行。
7. 使用中文分级编号：一级使用“一、二、三”，二级使用“1、2、3”。
8. 真正重要的英文词语或句子用 **加粗** 或 __下划线__ 标记；不要使用项目符号、星号装饰或短横线。
英文：
${text}
`.trim();
    }

    // =========================================================
    // 详细分析 Prompt
    // =========================================================

    function detailPrompt(text) {
        return `
你是一名专业英语语法教师，帮助中国学习者理解英语长难句。
请详细但紧凑地分析下面英文。
严格按以下格式输出，各部分之间不要空行：
一、句子主干
1、指出主语、谓语、宾语或表语，并给出核心句子骨架。
二、结构拆分
1、分析主句、从句、非谓语和插入结构，并说明作用。
