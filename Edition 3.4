        const input = document.getElementById('ai-pure-translation-input');
        input.value = await getSelectedOrClipboardText();
        input.focus();
    }

    async function articleAnalyze(detail = false, forcedText = '') {
        if (requestBusy) {
            setStatus('当前已有请求正在处理中', 'working');
            return;
        }

        if (!forcedText && (!clipboardTextLoaded || !clipboardText)) {
            setStatus('请先点击 📋 读取剪贴板文章', 'error');
            openPanel();
            return;
        }

        const sourceText = forcedText || clipboardText;
        if (detectLanguage(sourceText) !== 'en') {
            setStatus('文章分析仅支持英文文章', 'error');
            openPanel();
            return;
        }

        let text = sourceText;
        let truncated = false;
        if (text.length > ARTICLE_MAX_CHARS) {
            text = text.slice(0, ARTICLE_MAX_CHARS);
            truncated = true;
        }

        requestBusy = true;
        openPanel();
        setStatus(detail ? '正在详细分析文章结构…' : '正在快速分析文章结构…', 'working');
        content.innerHTML = `<div class="ai-card"><div class="ai-label">${detail ? '文章详析' : '文章快析'}</div><div class="ai-text">正在分析文章主题、段落结构和逻辑关系…</div></div>`;

        lastRequest = () => articleAnalyze(detail, text);
        try {
            const result = await requestAPI(
                detail ? articleDetailPrompt(text) : articleQuickPrompt(text),
                detail ? DETAIL_TIMEOUT : NORMAL_TIMEOUT
            );
            showResult(text, detail ? '文章详细分析' : '文章快速分析', result);
            setStatus(truncated ? '分析完成（文章过长，已截取前 30000 个字符）' : '文章分析完成', 'success');
            if (truncated) {
                const notice = document.createElement('div');
                notice.className = 'ai-card ai-card-error';
                notice.textContent = '提示：原文章超过 30000 个字符，本次仅分析了开头部分。';
                content.insertBefore(notice, content.firstChild);
            }
        } catch (error) {
            if (isCancelledError(error)) return;
            setStatus('文章分析失败：' + error.message, 'error');
            showError('文章分析失败', error.message === 'TIMEOUT' ? 'API 请求超时，请缩短文章后重试。' : error.message);
        } finally {
            requestBusy = false;
        }
    }

    async function batchTranslateVocabulary() {
        if (requestBusy) {
            setStatus('当前已有请求正在处理中', 'working');
            return;
        }
        const input = document.getElementById('ai-translation-input');
        const entries = [...new Set(input.value.split(/\r?\n|[,，;；]/).map(item => item.trim()).filter(Boolean))].slice(0, 10);
        if (!entries.length) {
            setStatus('请每行输入一个单词或短语', 'error');
            input.focus();
            updateFavoriteButton();
            return;
        }
        requestBusy = true;
        translationDialog.style.display = 'none';
        openPanel();
        setStatus(`正在批量查询 ${entries.length} 个词条…`, 'working');
        content.innerHTML = '<div class="ai-card"><div class="ai-label">批量快速翻译</div><div class="ai-text">正在逐条生成释义…</div></div>';
        lastRequest = batchTranslateVocabulary;
        const results = [];
        try {
            for (let index = 0; index < entries.length; index += 1) {
                const entry = entries[index];
                setStatus(`正在批量查询 ${index + 1}/${entries.length}：${entry}`, 'working');
                const answer = await requestAPI(vocabularyPrompt(entry, false), NORMAL_TIMEOUT);
                results.push(`一、${entry}\n${answer.replace(/^一、[^\n]*\n?/, '')}`);
            }
            showResult(entries.join('、'), '批量词汇翻译', results.join('\n\n'));
            setStatus('批量翻译完成', 'success');
        } catch (error) {
            if (isCancelledError(error)) return;
            if (results.length) {
                showResult(entries.slice(0, results.length).join('、'), '批量词汇翻译（部分完成）', results.join('\n\n'));
                setStatus(`批量翻译部分完成：${results.length}/${entries.length}，${error.message}`, 'error');
            } else {
                setStatus('批量翻译失败：' + error.message, 'error');
                showError('批量翻译失败', error.message);
            }
        } finally {
            requestBusy = false;
        }
    }

