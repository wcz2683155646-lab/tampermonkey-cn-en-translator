    // =========================================================
    // 状态系统
    // =========================================================

    function setStatus(
        text,
        type = 'ready'
    ) {
        statusText.textContent =
            text;

        statusBox
            .classList
            .remove(
                'ai-working',
                'ai-success',
                'ai-error'
            );

        statusIcon
            .removeAttribute(
                'style'
            );

        if (
            type === 'working'
        ) {
            statusBox
                .classList
                .add(
                    'ai-working'
                );

            statusIcon.className =
                'ai-status-spinner';

            return;
        }

        statusIcon.className =
            'ai-status-dot';

        if (
            type === 'success'
        ) {
            statusBox
                .classList
                .add(
                    'ai-success'
                );

            statusIcon.style.background =
                '#22c55e';

            statusIcon.style.boxShadow =
                '0 0 0 4px rgba(34,197,94,.14)';

            return;
        }

        if (
            type === 'error'
        ) {
            statusBox
                .classList
                .add(
                    'ai-error'
                );

            statusIcon.style.background =
                '#ef4444';

            statusIcon.style.boxShadow =
                '0 0 0 4px rgba(239,68,68,.14)';

            return;
        }

        statusIcon.style.background =
            '#22c55e';

        statusIcon.style.boxShadow =
            '0 0 0 4px rgba(34,197,94,.14)';
    }

    // =========================================================
    // 悬浮球位置
    // =========================================================

    const savedX =
        GM_getValue(
            'translator_ball_x',
            window.innerWidth - 75
        );

    const savedY =
        GM_getValue(
            'translator_ball_y',
            Math.round(
                window.innerHeight * 0.35
            )
        );

    function setContainerPosition(
        x,
        y
    ) {
        const maxX =
            window.innerWidth -
            BALL_SIZE;

        const maxY =
            window.innerHeight -
            BALL_SIZE;

        x =
            Math.max(
                0,
                Math.min(
                    Number(x) || 0,
                    maxX
                )
            );

        y =
            Math.max(
                0,
                Math.min(
                    Number(y) || 0,
                    maxY
                )
            );

        container.style.left =
            x + 'px';

        container.style.top =
            y + 'px';

        container.style.right =
            'auto';

        return {
            x,
            y
        };
    }

    setContainerPosition(
        savedX,
        savedY
    );

    // =========================================================
    // 面板展开方向
    // =========================================================

    function updatePanelDirection() {
        const rect =
            ball
                .getBoundingClientRect();

        if (
            rect.left >
            PANEL_WIDTH + 25
        ) {
            panel.style.right =
                '56px';

            panel.style.left =
                'auto';
        } else {
            panel.style.left =
                '56px';

            panel.style.right =
                'auto';
        }

        const panelHeight =
            panel.getBoundingClientRect().height ||
            Math.min(
                window.innerHeight * 0.5,
                560
            );

        if (
            rect.top +
            panelHeight >
            window.innerHeight
        ) {
            panel.style.top =
                'auto';

            panel.style.bottom =
                '0';
        } else {
            panel.style.top =
                '0';

            panel.style.bottom =
                'auto';
        }
    }

    // =========================================================
    // 面板开关
    // =========================================================

    function openPanel() {
        updatePanelDirection();

        container
            .classList
            .add(
                'ai-open'
            );

        panelOpen = true;
    }

    function closePanel() {
        settingsPanel
            .style
            .display =
                'none';

        questionPanel.style.display = 'none';
        translationDialog.style.display = 'none';
        pureTranslationDialog.style.display = 'none';

        container
            .classList
            .remove(
                'ai-open'
            );

        panelOpen = false;
    }

    function togglePanel() {
        if (panelOpen) {
            closePanel();
        } else {
            openPanel();
        }
    }

    // =========================================================
    // 拖动悬浮球
    // =========================================================

    let dragging = false;
    let moved = false;

    let startMouseX = 0;
    let startMouseY = 0;

    let startX = 0;
    let startY = 0;

    ball.addEventListener(
        'mousedown',
        event => {

            if (
                event.button !== 0
            ) {
                return;
            }

            dragging = true;
            moved = false;

            startMouseX =
                event.clientX;

            startMouseY =
                event.clientY;

            const rect =
                container
                    .getBoundingClientRect();

            startX = rect.left;
            startY = rect.top;

            // 在悬浮球获得焦点前最后尝试保存页面选区；
            // 浏览器内置 PDF 阅读器可能会在随后清除选区。
            rememberSelection();

            event.preventDefault();
        }
    );

    document.addEventListener(
        'mousemove',
        event => {

            if (!dragging) {
                return;
            }

            const dx =
                event.clientX -
                startMouseX;

            const dy =
                event.clientY -
                startMouseY;

            if (
                Math.abs(dx) > 4 ||
                Math.abs(dy) > 4
            ) {
                moved = true;
            }

            const position =
                setContainerPosition(
                    startX + dx,
                    startY + dy
                );

            updatePanelDirection();

            GM_setValue(
                'translator_ball_x',
                position.x
            );

            GM_setValue(
                'translator_ball_y',
                position.y
            );
        }
    );

    document.addEventListener(
        'mouseup',
        () => {
            dragging = false;
        }
    );

    let resizing = false;
    let resizeStartY = 0;
    let resizeStartHeight = 0;

    resizeHandle.addEventListener('mousedown', event => {
        if (event.button !== 0) return;
        resizing = true;
        resizeStartY = event.clientY;
        resizeStartHeight = panel.getBoundingClientRect().height;
        event.preventDefault();
        event.stopPropagation();
    });

    document.addEventListener('mousemove', event => {
        if (!resizing) return;
        const panelRect = panel.getBoundingClientRect();
        const availableHeight = panel.style.top === 'auto'
            ? Math.max(360, panelRect.bottom - 8)
            : Math.max(360, window.innerHeight - panelRect.top - 8);
        const nextHeight = Math.max(360, Math.min(availableHeight, resizeStartHeight + event.clientY - resizeStartY));
        panel.style.height = `${nextHeight}px`;
        updatePanelDirection();
    });

    document.addEventListener('mouseup', () => {
        if (resizing) {
            GM_setValue('translator_panel_height', Math.round(panel.getBoundingClientRect().height));
        }
        resizing = false;
    });

    ball.addEventListener(
        'click',
        event => {

            event.stopPropagation();

            if (moved) {
                moved = false;
                return;
            }

            togglePanel();
        }
    );

    function setupMenu(menuId) {
        const menu = document.getElementById(menuId);
        const trigger = menu.querySelector(':scope > button');
        trigger.addEventListener('click', event => {
            event.stopPropagation();
            document.querySelectorAll('.ai-menu.ai-menu-open').forEach(other => {
                if (other !== menu) other.classList.remove('ai-menu-open');
            });
            menu.classList.toggle('ai-menu-open');
        });
        menu.querySelector('.ai-submenu').addEventListener('click', event => event.stopPropagation());
    }

    setupMenu('ai-sentence-menu');
    setupMenu('ai-article-menu');
    document.addEventListener('click', () => {
        document.querySelectorAll('.ai-menu.ai-menu-open').forEach(menu => menu.classList.remove('ai-menu-open'));
    });

    // =========================================================
    // 显示输入预览
    // =========================================================

    function showInputPreview(text) {
        content.innerHTML = '';

        const card =
            document.createElement(
                'div'
            );

        card.className =
            'ai-card ai-card-original';

        card.innerHTML = `
<div class="ai-label">
    <span
        class="ai-dot ai-dot-blue"
    ></span>
    已读取文本
</div>

<div class="ai-text"></div>
`;

        card
            .querySelector(
                '.ai-text'
            )
            .textContent =
            text;

        content
            .appendChild(
                card
            );

        openPanel();
    }

    // =========================================================
    // 显示结果
    // =========================================================

    function showResult(
        original,
        title,
        result
    ) {
        result =
            cleanResult(result);

        lastResult =
            result;

        content.innerHTML =
            '';

        const originalCard =
            document.createElement(
                'div'
            );

        originalCard.className =
            'ai-card ai-card-original';

        originalCard.innerHTML = `
<div class="ai-label">
    <span
        class="ai-dot ai-dot-blue"
    ></span>
    原文
</div>

<div class="ai-text"></div>
`;

        originalCard
            .querySelector(
                '.ai-text'
            )
            .textContent =
            original;

        const resultCard =
            document.createElement(
                'div'
            );

        resultCard.className =
            'ai-card ai-card-result';

        resultCard.innerHTML = `
<div class="ai-label">
    <span
        class="ai-dot ai-dot-purple"
    ></span>

    <span
        class="ai-result-title"
    ></span>
</div>

<div class="ai-text ai-result-content"></div>
<div class="ai-result-actions">
    <button class="ai-result-regenerate">重新生成</button>
</div>
`;

        resultCard
            .querySelector(
                '.ai-result-title'
            )
            .textContent =
            title;

        const resultContent = resultCard.querySelector('.ai-result-content');
        if (title.includes('详细')) {
            const sections = result.split(/(?=^[一二三四五六七八九十]+、)/m).filter(Boolean);
            resultContent.innerHTML = '';
            sections.forEach(section => {
                const lineBreak = section.indexOf('\n');
                const heading = lineBreak >= 0 ? section.slice(0, lineBreak) : section;
                const body = lineBreak >= 0 ? section.slice(lineBreak + 1) : '';
                const sectionBox = document.createElement('div');
                sectionBox.className = 'ai-result-section ai-section-collapsed';
                sectionBox.innerHTML = `<button class="ai-result-section-title"><span></span><span class="ai-result-section-icon">＋</span></button><div class="ai-result-section-body"></div>`;
                sectionBox.querySelector('.ai-result-section-title span:first-child').textContent = heading;
                sectionBox.querySelector('.ai-result-section-body').innerHTML = formatResult(body);
                sectionBox.querySelector('.ai-result-section-title').addEventListener('click', () => {
                    const collapsed = sectionBox.classList.toggle('ai-section-collapsed');
                    sectionBox.querySelector('.ai-result-section-icon').textContent = collapsed ? '＋' : '－';
                });
                resultContent.appendChild(sectionBox);
            });
        } else {
            resultContent.innerHTML = formatResult(result);
        }

        resultCard.querySelector('.ai-result-regenerate').addEventListener('click', () => {
            if (lastRequest) lastRequest();
        });

        content
            .appendChild(
                originalCard
            );

        content
            .appendChild(
                resultCard
            );

        if (title === '英语问题回答') {
            const followup = document.createElement('div');
            followup.className = 'ai-card ai-followup-card';
            followup.innerHTML = '<div class="ai-label">继续追问</div><div class="ai-text">点击标题栏的“？”可继续当前对话，或新建对话。</div>';
            content.appendChild(followup);
        }
    }

