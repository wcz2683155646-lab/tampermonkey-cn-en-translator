                try {
                    await navigator
                        .clipboard
                        .writeText(
                            lastResult
                        );

                    setStatus(
                        '已复制到剪贴板',
                        'success'
                    );
                } catch {
                    const textarea =
                        document
                            .createElement(
                                'textarea'
                            );

                    textarea.value =
                        lastResult;

                    textarea.style.position =
                        'fixed';

                    textarea.style.left =
                        '-9999px';

                    textarea.style.top =
                        '-9999px';

                    (
                        document.body ||
                        document.documentElement
                    ).appendChild(
                        textarea
                    );

                    textarea.focus();
                    textarea.select();

                    try {
                        const success =
                            document.execCommand(
                                'copy'
                            );

                        if (success) {
                            setStatus(
                                '已复制到剪贴板',
                                'success'
                            );
                        } else {
                            setStatus(
                                '复制失败，请手动复制',
                                'error'
                            );
                        }
                    } catch {
                        setStatus(
                            '复制失败，请手动复制',
                            'error'
                        );
                    }

                    textarea.remove();
                }
            }
        );

    // =========================================================
    // 清空
    // =========================================================

    document
        .getElementById(
            'ai-clear'
        )
        .addEventListener(
            'click',
            () => {

                currentText = '';
                lastResult = '';

                content.innerHTML = `
<div class="ai-card">

    <div class="ai-label">
        已清空
    </div>

    <div class="ai-text">
        选择中文或英文后按 Alt + T 开始翻译。
    </div>

</div>
`;

                setStatus(
                    '准备就绪',
                    'ready'
                );
            }
        );

    // =========================================================
    // Alt + T 快捷翻译
    // =========================================================

    document.addEventListener(
        'keydown',
        event => {

            if (
                event.altKey &&
                !event.ctrlKey &&
                !event.shiftKey &&
                !event.metaKey &&
                String(
                    event.key
                ).toLowerCase() ===
                't'
            ) {
                event.preventDefault();
                event.stopPropagation();

                translate();
            }
        },
        true
    );

    // =========================================================
    // 窗口变化
    // =========================================================

    window.addEventListener(
        'resize',
        () => {

            const rect =
                container
                    .getBoundingClientRect();

            const position =
                setContainerPosition(
                    rect.left,
                    rect.top
                );

            GM_setValue(
                'translator_ball_x',
                position.x
            );

            GM_setValue(
                'translator_ball_y',
                position.y
            );

            if (panelOpen) {
                updatePanelDirection();
            }
        }
    );

    // =========================================================
    // 初始化
    // =========================================================

    setStatus(
        '准备就绪',
        'ready'
    );

})();
