    // =========================================================
    // 拖动悬浮球
    // =========================================================

    let dragging = false;
    let moved = false;

    let startMouseX = 0;
    let startMouseY = 0;

    let startX = 0;
    let startY = 0;

    ball.addEventListener(
        'mousedown',
        event => {

            if (
                event.button !== 0
            ) {
                return;
            }

            dragging = true;
            moved = false;

            startMouseX =
                event.clientX;

            startMouseY =
                event.clientY;

            const rect =
                container
                    .getBoundingClientRect();

            startX = rect.left;
            startY = rect.top;

            event.preventDefault();
        }
    );

    document.addEventListener(
        'mousemove',
        event => {

            if (!dragging) {
                return;
            }

            const dx =
                event.clientX -
                startMouseX;

            const dy =
                event.clientY -
                startMouseY;

            if (
                Math.abs(dx) > 4 ||
                Math.abs(dy) > 4
            ) {
                moved = true;
            }

            const position =
                setContainerPosition(
                    startX + dx,
                    startY + dy
                );

            updatePanelDirection();

            GM_setValue(
                'translator_ball_x',
                position.x
            );

            GM_setValue(
                'translator_ball_y',
                position.y
            );
        }
    );

    document.addEventListener(
        'mouseup',
        () => {
            dragging = false;
        }
    );

    ball.addEventListener(
        'click',
        event => {

            event.stopPropagation();

            if (moved) {
                moved = false;
                return;
            }

            togglePanel();
        }
    );

