// ==UserScript==
// @name         中英互译 + 英语长难句分析 Pro
// @namespace    tampermonkey-cn-en-translator
// @version      2.4.2
// @description  悬浮翻译助手：中英互译、快速/详细长难句分析、剪贴板、状态动画
// @match        http://*/*
// @match        https://*/*
// @match        file:///*
// @grant        GM_xmlhttpRequest
// @grant        GM_getValue
// @grant        GM_setValue
// @connect      api.openclawplan.com
// @run-at       document-idle
// ==/UserScript==

(() => {
    'use strict';

    const DEFAULT_BASE_URL = 'https://api.openclawplan.com/v1';
    const DEFAULT_MODEL = 'gpt-5.6-terra';

    const NORMAL_TIMEOUT = 60000;
    const DETAIL_TIMEOUT = 180000;

    const BALL_SIZE = 44;
    const PANEL_WIDTH = 420;

    let currentText = '';
    let lastResult = '';
    let panelOpen = false;
    let requestBusy = false;

    // =========================================================
    // API 配置
    // =========================================================

    function getConfig() {
        return {
            apiKey: GM_getValue('translator_api_key', ''),
            baseUrl: GM_getValue(
                'translator_base_url',
                DEFAULT_BASE_URL
            ),
            model: GM_getValue(
                'translator_model',
                DEFAULT_MODEL
            )
        };
    }

    function saveConfig(apiKey, baseUrl, model) {
        GM_setValue(
            'translator_api_key',
            apiKey.trim()
        );

        GM_setValue(
            'translator_base_url',
            (baseUrl.trim() || DEFAULT_BASE_URL)
                .replace(/\/+$/, '')
        );

        GM_setValue(
            'translator_model',
            model.trim() || DEFAULT_MODEL
        );
    }

    // =========================================================
    // 判断语言
    // =========================================================

    function detectLanguage(text) {
        text = String(text || '');

        const zh =
            (text.match(/[\u4e00-\u9fff]/g) || []).length;

        const en =
            (text.match(/[A-Za-z]/g) || []).length;

        if (!zh && !en) return 'unknown';
        if (zh && !en) return 'zh';
        if (en && !zh) return 'en';

        const total = zh + en;

        if (zh / total >= 0.6) return 'zh';
        if (en / total >= 0.6) return 'en';

        return 'mixed';
    }

    // =========================================================
    // 获取选中文字
    // =========================================================

    function getSelectedText() {
        const active = document.activeElement;

        if (
            active &&
            (
                active.tagName === 'TEXTAREA' ||
                active.tagName === 'INPUT'
            )
        ) {
            const start = active.selectionStart;
            const end = active.selectionEnd;

            if (
                typeof start === 'number' &&
                typeof end === 'number' &&
                end > start
            ) {
                return active.value
                    .slice(start, end)
                    .trim();
            }
        }

        try {
            return String(
                window.getSelection()?.toString() || ''
            ).trim();
        } catch {
            return '';
        }
    }

    // =========================================================
    // 清理输出格式
    // =========================================================

    function cleanResult(text) {
        return String(text || '')
            .replace(/\r\n/g, '\n')
            .replace(/[ \t]+\n/g, '\n')
            .replace(/\n[ \t]+\n/g, '\n')
            .replace(/\n{2,}/g, '\n')
            .trim();
    }

    // =========================================================
    // Responses API 解析
    // =========================================================

    function extractOutput(data) {
        if (!data) return '';

        if (
            typeof data.output_text === 'string'
        ) {
            return data.output_text.trim();
        }

        if (Array.isArray(data.output)) {
            const parts = [];

            for (const item of data.output) {
                if (!Array.isArray(item?.content)) {
                    continue;
                }

                for (const c of item.content) {
                    if (
                        typeof c?.text === 'string'
                    ) {
                        parts.push(c.text);
                    } else if (
                        c?.text &&
                        typeof c.text.value === 'string'
                    ) {
                        parts.push(c.text.value);
                    }
                }
            }

            return parts.join('\n').trim();
        }

        if (
            data.response &&
            typeof data.response.output_text === 'string'
        ) {
            return data.response.output_text.trim();
        }

        return '';
    }

    // =========================================================
    // API 请求
    // =========================================================

    function requestAPI(
        prompt,
        timeout = NORMAL_TIMEOUT
    ) {
        const config = getConfig();

        return new Promise((resolve, reject) => {
            if (!config.apiKey) {
                reject(
                    new Error('请先在设置中填写 API Key')
                );
                return;
            }

            const url =
                config.baseUrl.replace(/\/+$/, '') +
                '/responses';

            GM_xmlhttpRequest({
                method: 'POST',
                url,

                headers: {
                    'Content-Type': 'application/json',
                    'Authorization':
                        'Bearer ' + config.apiKey
                },

                data: JSON.stringify({
                    model: config.model,

                    reasoning: {
                        effort: 'low'
                    },

                    store: false,

                    input: prompt
                }),

                timeout,

                onload(response) {
                    let data;

                    try {
                        data =
                            JSON.parse(
                                response.responseText
                            );
                    } catch {
                        reject(
                            new Error(
                                'API 返回内容不是有效 JSON'
                            )
                        );
                        return;
                    }

                    if (
                        response.status < 200 ||
                        response.status >= 300
                    ) {
                        reject(
                            new Error(
                                data?.error?.message ||
                                data?.message ||
                                'HTTP ' + response.status
                            )
                        );
                        return;
                    }

                    const output =
                        extractOutput(data);

                    if (!output) {
                        reject(
                            new Error(
                                'API 返回成功，但没有找到文本结果'
                            )
                        );
                        return;
                    }

                    resolve(
                        cleanResult(output)
                    );
                },

                onerror() {
                    reject(
                        new Error('网络请求失败')
                    );
                },

                ontimeout() {
                    reject(
                        new Error('TIMEOUT')
                    );
                },

                onabort() {
                    reject(
                        new Error('请求已取消')
                    );
                }
            });
        });
    }

