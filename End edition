    function setContainerPosition(
        x,
        y
    ) {
        const maxX =
            window.innerWidth -
            BALL_SIZE;

        const maxY =
            window.innerHeight -
            BALL_SIZE;

        x =
            Math.max(
                0,
                Math.min(
                    Number(x) || 0,
                    maxX
                )
            );

        y =
            Math.max(
                0,
                Math.min(
                    Number(y) || 0,
                    maxY
                )
            );

        container.style.left =
            x + 'px';

        container.style.top =
            y + 'px';

        container.style.right =
            'auto';

        return {
            x,
            y
        };
    }

    setContainerPosition(
        savedX,
        savedY
    );

    // =========================================================
