    async function translate() {
        if (requestBusy) {
            setStatus(
                '当前已有请求正在处理中',
                'working'
            );
            return;
        }

        let text =
            getSelectedText();

        if (!text) {
            text = currentText;
        }

        if (!text) {
            setStatus(
                '请先选中文字，或点击 📋 读取剪贴板',
                'error'
            );

            openPanel();

            return;
        }

        currentText = text;

        const lang =
            detectLanguage(text);

        if (
            lang !== 'zh' &&
            lang !== 'en'
        ) {
            setStatus(
                '仅支持中文和英文互译',
                'error'
            );

            openPanel();

            return;
        }

        requestBusy = true;

        openPanel();

        setStatus(
            lang === 'zh'
                ? '正在翻译：中文 → 英文…'
                : '正在翻译：英文 → 中文…',
            'working'
        );

        content.innerHTML = `
<div class="ai-card">
    <div class="ai-label">
        正在翻译
    </div>

    <div class="ai-text">
        AI 正在生成翻译结果…
    </div>
</div>
`;

        try {
            const result =
                await requestAPI(
                    translatePrompt(
                        text,
                        lang
                    ),
                    NORMAL_TIMEOUT
                );

            showResult(
                text,
                lang === 'zh'
                    ? '英文翻译'
                    : '中文翻译',
                result
            );

            setStatus(
                '翻译完成',
                'success'
            );
        } catch (error) {
            if (
                error.message ===
                'TIMEOUT'
