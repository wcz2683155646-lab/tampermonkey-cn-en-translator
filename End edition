    async function readClipboardText() {
        try {
            const text =
                await navigator
                    .clipboard
                    .readText();

            if (!text.trim()) {
                setStatus(
                    '剪贴板中没有文本',
                    'error'
                );

                return '';
            }

            currentText =
                text.trim();

            showInputPreview(
                currentText
            );

            setStatus(
                '已读取剪贴板文本',
                'success'
            );

            return currentText;
        } catch {
            setStatus(
                '无法读取剪贴板，请检查浏览器剪贴板权限',
                'error'
            );

            return '';
        }
    }

    // =========================================================
