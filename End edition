    function updatePanelDirection() {
        const rect =
            ball
                .getBoundingClientRect();

        if (
            rect.left >
            PANEL_WIDTH + 25
        ) {
            panel.style.right =
                '56px';

            panel.style.left =
                'auto';
        } else {
            panel.style.left =
                '56px';

            panel.style.right =
                'auto';
        }

        const panelHeight =
            Math.min(
                window.innerHeight * 0.5,
                560
            );

        if (
            rect.top +
            panelHeight >
            window.innerHeight
        ) {
            panel.style.top =
                'auto';

            panel.style.bottom =
                '0';
        } else {
            panel.style.top =
                '0';

            panel.style.bottom =
                'auto';
        }
    }

