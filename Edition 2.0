// ==UserScript==
// @name         中英互译 + 英语长难句分析 Pro
// @namespace    tampermonkey-cn-en-translator
// @version      2.4.2
// @description  悬浮翻译助手：中英互译、快速/详细长难句分析、剪贴板、状态动画
// @match        http://*/*
// @match        https://*/*
// @match        file:///*
// @grant        GM_xmlhttpRequest
// @grant        GM_getValue
// @grant        GM_setValue
// @connect      api.openclawplan.com
// @run-at       document-idle
// ==/UserScript==

(() => {
    'use strict';

    const DEFAULT_BASE_URL = 'https://api.openclawplan.com/v1';
    const DEFAULT_MODEL = 'gpt-5.6-terra';

    const NORMAL_TIMEOUT = 60000;
    const DETAIL_TIMEOUT = 180000;
    const ARTICLE_MAX_CHARS = 30000;

    const BALL_SIZE = 44;
    const PANEL_WIDTH = 420;

    let currentText = '';
    let lastSelectedText = '';
    let lastResult = '';
    let panelOpen = false;
    let requestBusy = false;
    let clipboardTextLoaded = false;
    let questionHistory = [];
    const MAX_QUESTION_TURNS = 6;

    // =========================================================
    // API 配置
    // =========================================================

    function getConfig() {
        return {
            apiKey: GM_getValue('translator_api_key', ''),
            baseUrl: GM_getValue(
                'translator_base_url',
                DEFAULT_BASE_URL
            ),
            model: GM_getValue(
                'translator_model',
                DEFAULT_MODEL
            )
        };
    }

    function saveConfig(apiKey, baseUrl, model) {
        GM_setValue(
            'translator_api_key',
            apiKey.trim()
        );

        GM_setValue(
            'translator_base_url',
            (baseUrl.trim() || DEFAULT_BASE_URL)
                .replace(/\/+$/, '')
        );

        GM_setValue(
            'translator_model',
            model.trim() || DEFAULT_MODEL
        );
    }

    // =========================================================
    // 判断语言
    // =========================================================

    function detectLanguage(text) {
        text = String(text || '');

        const zh =
            (text.match(/[\u4e00-\u9fff]/g) || []).length;

        const en =
            (text.match(/[A-Za-z]/g) || []).length;

        if (!zh && !en) return 'unknown';
        if (zh && !en) return 'zh';
        if (en && !zh) return 'en';

        const total = zh + en;

        if (zh / total >= 0.6) return 'zh';
        if (en / total >= 0.6) return 'en';

        return 'mixed';
    }

    // =========================================================
    // 获取选中文字
    // =========================================================

    function getSelectedText() {
        const active = document.activeElement;

        if (
            active &&
            (
                active.tagName === 'TEXTAREA' ||
                active.tagName === 'INPUT'
            )
        ) {
            const start = active.selectionStart;
            const end = active.selectionEnd;

            if (
                typeof start === 'number' &&
                typeof end === 'number' &&
                end > start
            ) {
                return active.value
                    .slice(start, end)
                    .trim();
            }
        }

        try {
            return String(
                window.getSelection()?.toString() || ''
            ).trim();
        } catch {
            return '';
        }
    }

    // =========================================================
    // 清理输出格式
    // =========================================================

    function cleanResult(text) {
        return String(text || '')
            .replace(/\r\n/g, '\n')
            // 去掉模型常见的 Markdown 项目符号和装饰符号，保留文字内容
            .replace(/^\s*[-*+]\s+/gm, '')
            .replace(/^\s*#{1,6}\s+/gm, '')
            .replace(/[ \t]+\n/g, '\n')
            .replace(/\n[ \t]+\n/g, '\n')
            .replace(/\n{2,}/g, '\n')
            .trim();
    }

    function formatResult(text) {
        const escaped = cleanResult(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');

        return escaped
            .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
            .replace(/__(.+?)__/g, '<u>$1</u>')
            .replace(/(^|[\s：:])\*([^*\n]+?)\*(?=\s|$)/g, '$1$2')
            .replace(/\n/g, '<br>');
    }

    // =========================================================
    // Responses API 解析
    // =========================================================

    function extractOutput(data) {
        if (!data) return '';

        if (
            typeof data.output_text === 'string'
        ) {
            return data.output_text.trim();
        }

        if (Array.isArray(data.output)) {
            const parts = [];

            for (const item of data.output) {
                if (!Array.isArray(item?.content)) {
                    continue;
                }

                for (const c of item.content) {
                    if (
                        typeof c?.text === 'string'
                    ) {
                        parts.push(c.text);
                    } else if (
                        c?.text &&
                        typeof c.text.value === 'string'
                    ) {
                        parts.push(c.text.value);
                    }
                }
            }

            return parts.join('\n').trim();
        }

        if (
            data.response &&
            typeof data.response.output_text === 'string'
        ) {
            return data.response.output_text.trim();
        }

        return '';
    }

    // =========================================================
    // API 请求
    // =========================================================

    function requestAPI(
        prompt,
        timeout = NORMAL_TIMEOUT
    ) {
        const config = getConfig();

        return new Promise((resolve, reject) => {
            if (!config.apiKey) {
                reject(
                    new Error('请先在设置中填写 API Key')
                );
                return;
            }

            const url =
                config.baseUrl.replace(/\/+$/, '') +
                '/responses';

            GM_xmlhttpRequest({
                method: 'POST',
                url,

                headers: {
                    'Content-Type': 'application/json',
                    'Authorization':
                        'Bearer ' + config.apiKey
                },

                data: JSON.stringify({
                    model: config.model,

                    reasoning: {
                        effort: 'low'
                    },

                    store: false,

                    input: prompt
                }),

                timeout,

                onload(response) {
                    let data;

                    try {
                        data =
                            JSON.parse(
                                response.responseText
                            );
                    } catch {
                        reject(
                            new Error(
                                'API 返回内容不是有效 JSON'
                            )
                        );
                        return;
                    }

                    if (
                        response.status < 200 ||
                        response.status >= 300
                    ) {
                        reject(
                            new Error(
                                data?.error?.message ||
                                data?.message ||
                                'HTTP ' + response.status
                            )
                        );
                        return;
                    }

                    const output =
                        extractOutput(data);

                    if (!output) {
                        reject(
                            new Error(
                                'API 返回成功，但没有找到文本结果'
                            )
                        );
                        return;
                    }

                    resolve(
                        cleanResult(output)
                    );
                },

                onerror() {
                    reject(
                        new Error('网络请求失败')
                    );
                },

                ontimeout() {
                    reject(
                        new Error('TIMEOUT')
                    );
                },

                onabort() {
                    reject(
                        new Error('请求已取消')
                    );
                }
            });
        });
    }

    // =========================================================
    // 翻译 Prompt
    // =========================================================

    function translatePrompt(text, lang) {
        if (lang === 'zh') {
            return `
You are a professional Chinese-English translator.
Translate the following Chinese text into natural, accurate and fluent English.
Requirements:
1. Preserve meaning, terminology, names, numbers and paragraph structure.
2. Do not explain or analyze.
3. Do not add notes.
4. Return only the English translation.
Chinese text:
${text}
`.trim();
        }

        return `
You are a professional English-Chinese translator.
Translate the following English text into natural and accurate Simplified Chinese.
Requirements:
1. Preserve meaning, terminology, names, numbers and paragraph structure.
2. Make the Chinese natural and fluent.
3. Do not explain or analyze.
4. Do not add notes.
5. Return only the Chinese translation.
English text:
${text}
`.trim();
    }

    // =========================================================
    // 快速分析 Prompt
    // =========================================================

    function quickPrompt(text) {
        return `
你是一名英语老师。快速分析下面英文，只保留真正有助于理解的内容。
严格按以下格式输出，各部分之间不要空行：
【主干】
一行指出核心主谓宾或主系表。
【结构】
简洁指出最重要的从句、非谓语和关键修饰关系。
【难点】
只列 1～3 个最重要的词组、搭配或语法难点。
【翻译】
给出自然准确的简体中文翻译。
要求：
1. 不展开讲课。
2. 不重复原句。
3. 不解释简单词汇和简单语法。
4. 整体尽量控制在 250 个中文字以内。
5. 不使用 Markdown 表格。
6. 不加入空白行。
7. 使用中文分级编号：一级使用“一、二、三”，二级使用“1、2、3”。
8. 真正重要的英文词语或句子用 **加粗** 或 __下划线__ 标记；不要使用项目符号、星号装饰或短横线。
英文：
${text}
`.trim();
    }

    // =========================================================
    // 详细分析 Prompt
    // =========================================================

    function detailPrompt(text) {
        return `
你是一名专业英语语法教师，帮助中国学习者理解英语长难句。
请详细但紧凑地分析下面英文。
严格按以下格式输出，各部分之间不要空行：
【句子主干】
指出主语、谓语、宾语或表语，并给出核心句子骨架。
【结构拆分】
分析真正影响理解的主句、从句、非谓语和插入结构，并说明作用。
【修饰关系】
指出重要介词短语、分词、不定式、定语从句修饰什么；重要代词说明指代。
【重点词组】
最多列 5 个重要固定搭配、短语或词义。
【理解难点】
最多用 3 点说明最容易误解的结构。
【自然翻译】
给出自然准确的简体中文翻译。
要求：
1. 必须针对原句。
2. 不逐词讲解。
3. 不解释简单语法。
4. 不重复内容。
5. 每部分尽量 2～4 行。
6. 整体尽量控制在 600 个中文字以内。
7. 不使用 Markdown 表格。
8. 不加入空白行。
9. 使用中文分级编号：一级使用“一、二、三”，二级使用“1、2、3”。
10. 真正重要的英文词语或句子用 **加粗** 或 __下划线__ 标记；不要使用项目符号、星号装饰或短横线。
英文：
${text}
`.trim();
    }

    // =========================================================
    // 详细分析超时备用 Prompt
    // =========================================================

    function fallbackPrompt(text) {
        return `
分析下面英文长难句。
严格按以下格式输出，不要空行：
【主干】
核心主谓宾或主系表。
【结构】
最重要的从句、非谓语和修饰关系。
【难点】
最多 3 个最影响理解的点。
【翻译】
自然准确的简体中文翻译。
要求：
1. 准确。
2. 不逐词分析。
3. 不解释简单内容。
4. 不重复。
5. 控制在 350 个中文字以内。
6. 使用中文分级编号：一级使用“一、二、三”，二级使用“1、2、3”。重点英文用 **加粗** 或 __下划线__ 标记；不要使用项目符号、星号装饰或短横线。
英文：
${text}
`.trim();
    }

    function questionPrompt(question) {
        return `
You are a patient English teacher helping a Chinese learner.
Answer the following English question clearly and accurately in Simplified Chinese.
Use short examples when helpful. Explain important English words or grammar briefly.
Organize the answer with Chinese hierarchical numbering: first level “一、二、三”, second level “1、2、3”.
Mark truly important English words or sentences with **bold** or __underline__.
Do not use bullet points, asterisks as decoration, hyphen lists, or Markdown tables. Keep the answer focused and clean.
Question:
${question}
`.trim();
    }

    function conversationPrompt(history, question) {
        const context = history.map((item, index) =>
            `${index + 1}. 用户问题：${item.question}\n助手回答：${item.answer}`
        ).join('\n\n');
        return `${questionPrompt(question)}\n\n${context ? `以下是此前对话，请结合上下文回答追问：\n${context}\n\n` : ''}本轮追问：\n${question}`;
    }

    function rememberSelection() {
        const text = getSelectedText();
        if (text) lastSelectedText = text;
    }

    document.addEventListener('selectionchange', rememberSelection, true);
    document.addEventListener('mouseup', rememberSelection, true);
    document.addEventListener('keyup', rememberSelection, true);

    function articleQuickPrompt(text) {
        return `
你是一名英语阅读与写作老师。请快速分析下面这篇英文文章的结构。
严格按以下格式输出，各部分之间不要空行：
【主题】
一句话概括文章主题和中心论点。
【段落结构】
按段落顺序简要说明每一段的功能和主要内容。
【逻辑关系】
指出文章最重要的论证、叙述关系、转折和逻辑连接。
【总结】
给出简洁准确的简体中文总结。
要求：不逐句翻译，不重复原文，不使用 Markdown 表格，整体尽量控制在 500 个中文字以内。使用中文分级编号：一级“一、二、三”，二级“1、2、3”；重点英文用 **加粗** 或 __下划线__ 标记；不要使用项目符号、星号装饰或短横线。
英文文章：
${text}
`.trim();
    }

    function articleDetailPrompt(text) {
        return `
你是一名专业英语阅读与写作教师。请详细但紧凑地分析下面这篇英文文章的结构。
严格按以下格式输出，各部分之间不要空行：
【文章主题与中心论点】
概括主题、作者目的和中心论点。
【整体结构】
说明文章的层次、组织方式以及开头、主体、结尾的作用。
【逐段概括】
按段落顺序概括每段内容和段落功能。
【论证与衔接】
分析论点、论据、结论之间的关系，以及重要转折和逻辑连接。
【重点表达】
列出最多 8 个对理解文章结构或内容有帮助的词组/表达并说明含义。
【中文总结】
给出自然准确的简体中文全文总结。
要求：必须针对原文，不逐词翻译，不解释简单词汇，不使用 Markdown 表格，整体尽量控制在 1200 个中文字以内。使用中文分级编号：一级“一、二、三”，二级“1、2、3”；重点英文用 **加粗** 或 __下划线__ 标记；不要使用项目符号、星号装饰或短横线。
英文文章：
${text}
`.trim();
    }

    // =========================================================
    // CSS
    // =========================================================

    const style =
        document.createElement('style');

    style.textContent = `
#ai-translator-container {
    position: fixed;
    z-index: 2147483647;
    width: 44px;
    height: 44px;
    font-family:
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        "PingFang SC",
        "Microsoft YaHei",
        sans-serif;
    color: #1f2937;
    user-select: none;
}

#ai-translator-ball {
    position: absolute;
    top: 0;
    right: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    background:
        linear-gradient(
            135deg,
            #2563eb,
            #6366f1 40%,
            #9333ea 72%,
            #db2777
        );
    border:
        1.5px solid
        rgba(255,255,255,.88);
    box-shadow:
        0 7px 22px
        rgba(79,70,229,.38);
    transition:
        transform .18s ease,
        box-shadow .18s ease;
}

#ai-translator-ball:hover {
    transform: scale(1.08);
    box-shadow:
        0 10px 30px
        rgba(124,58,237,.48);
}

#ai-translator-ball:active {
    cursor: grabbing;
}

.ai-ball-inner {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
        rgba(255,255,255,.13);
    color: white;
}

.ai-ball-icon {
    width: 21px;
    height: 21px;
}

#ai-translator-panel {
    position: absolute;
    width: 420px;
    height: 50vh;
    min-height: 360px;
    max-height: 560px;
    right: 56px;
    top: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background:
        rgba(255,255,255,.975);
    backdrop-filter:
        blur(22px);
    border:
        1px solid
        rgba(148,163,184,.30);
    border-radius: 18px;
    box-shadow:
        0 20px 60px
        rgba(15,23,42,.20);
    opacity: 0;
    visibility: hidden;
    transform:
        translateX(10px)
        scale(.98);
    transition:
        opacity .18s ease,
        transform .18s ease,
        visibility .18s;
    pointer-events: none;
    user-select: text;
}

#ai-resize-handle {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 8px;
    cursor: ns-resize;
    z-index: 60;
}

#ai-resize-handle::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 3px;
    width: 42px;
    height: 3px;
    border-radius: 3px;
    background: #cbd5e1;
    transform: translateX(-50%);
}

#ai-translator-container.ai-open
#ai-translator-panel {
    opacity: 1;
    visibility: visible;
    transform:
        translateX(0)
        scale(1);
    pointer-events: auto;
}

.ai-header {
    height: 60px;
    min-height: 60px;
    padding: 0 15px;
    display: flex;
    align-items: center;
    background:
        linear-gradient(
            120deg,
            rgba(59,130,246,.10),
            rgba(139,92,246,.10),
            rgba(236,72,153,.08)
        );
    border-bottom:
        1px solid #eef2f7;
}

.ai-logo {
    width: 36px;
    height: 36px;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 10px;
    color: white;
    font-weight: 800;
    background:
        linear-gradient(
            135deg,
            #3b82f6,
            #7c3aed
        );
    box-shadow:
        0 5px 14px
        rgba(99,102,241,.25);
}

.ai-header-text {
    flex: 1;
}

.ai-title {
    font-size: 15px;
    font-weight: 750;
    color: #111827;
}

.ai-subtitle {
    margin-top: 2px;
    font-size: 10px;
    color: #94a3b8;
}

#ai-translator-panel button {
    border: 0;
    border-radius: 9px;
    cursor: pointer;
    font-weight: 600;
    transition:
        transform .16s ease,
        filter .16s ease;
}

#ai-translator-panel button:hover {
    transform: translateY(-1px);
    filter: brightness(.98);
}

.ai-settings-btn {
    padding: 7px 10px;
    font-size: 12px;
    color: #475569;
    background:
        rgba(255,255,255,.8);
    border:
        1px solid
        #e2e8f0 !important;
}

.ai-toolbar {
    padding: 9px 11px;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 6px;
    background: #fafbff;
    border-bottom:
        1px solid #edf0f7;
}

.ai-question-btn {
    width: 34px;
    height: 32px;
    margin-right: 6px;
    padding: 0;
    color: #1d4ed8;
    background: #dbeafe;
    border: 1px solid #bfdbfe !important;
    font-size: 16px;
}

.ai-menu {
    position: relative;
}

.ai-menu > button {
    width: 100%;
}

.ai-submenu {
    position: absolute;
    top: calc(100% + 5px);
    left: 0;
    z-index: 70;
    display: none;
    min-width: 118px;
    padding: 5px;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    background: rgba(255,255,255,.98);
    box-shadow: 0 10px 24px rgba(15,23,42,.16);
}

.ai-menu.ai-menu-open .ai-submenu {
    display: grid;
    gap: 4px;
}

.ai-submenu button {
    height: 30px;
    padding: 0 9px;
    white-space: nowrap;
    text-align: left;
    font-size: 12px;
    color: #334155;
    background: #f8fafc;
}

.ai-toolbar button {
    height: 34px;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
}

.ai-btn-translate {
    color: white;
    background:
        linear-gradient(
            135deg,
            #3b82f6,
            #6366f1
        );
}

.ai-btn-quick {
    color: #92400e;
    background:
        linear-gradient(
            135deg,
            #fef3c7,
            #fde68a
        );
}

.ai-btn-analysis {
    color: white;
    background:
        linear-gradient(
            135deg,
            #8b5cf6,
            #a855f7
        );
}

.ai-btn-paste {
    color: #0369a1;
    background: #e0f2fe;
}

.ai-btn-copy {
    color: #047857;
    background: #ecfdf5;
}

.ai-btn-clear {
    color: #be123c;
    background: #fff1f2;
}

#ai-content {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    background:
        linear-gradient(
            180deg,
            #fff,
            #fafbff
        );
}

#ai-content::-webkit-scrollbar {
    width: 6px;
}

#ai-content::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 10px;
}

.ai-card {
    border:
        1px solid #e8ebf3;
    border-radius: 13px;
    padding: 11px 12px;
    margin-bottom: 9px;
    background:
        rgba(255,255,255,.96);
    box-shadow:
        0 3px 10px
        rgba(15,23,42,.035);
}

.ai-card-original {
    border-left:
        4px solid #3b82f6;
}

.ai-card-result {
    border-left:
        4px solid #8b5cf6;
}

.ai-card-error {
    border-left:
        4px solid #ef4444;
    background: #fffafa;
}

.ai-label {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 6px;
    font-size: 11px;
    font-weight: 750;
    color: #64748b;
}

.ai-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
}

.ai-dot-blue {
    background: #3b82f6;
    box-shadow:
        0 0 0 3px #dbeafe;
}

.ai-dot-purple {
    background: #8b5cf6;
    box-shadow:
        0 0 0 3px #ede9fe;
}

.ai-text {
    white-space: pre-wrap;
    word-break: break-word;
    line-height: 1.58;
    font-size: 13.5px;
    color: #334155;
}

.ai-text strong {
    color: #111827;
    font-weight: 800;
}

.ai-text u {
    text-decoration-thickness: 1.5px;
    text-decoration-color: #2563eb;
    text-underline-offset: 2px;
}

/* 状态栏 */

#ai-status {
    min-height: 46px;
    padding: 9px 13px;
    display: flex;
    align-items: center;
    border-top:
        1px solid #e2e8f0;
    background:
        linear-gradient(
            90deg,
            #f8fafc,
            #eef2ff
        );
    transition:
        background .2s ease;
}

.ai-status-indicator {
    width: 24px;
    height: 24px;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 10px;
}

.ai-status-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow:
        0 0 0 4px
        rgba(34,197,94,.14);
}

.ai-status-spinner {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border:
        2.5px solid
        rgba(99,102,241,.20);
    border-top-color:
        #6366f1;
    animation:
        ai-status-spin
        .7s linear infinite;
}

@keyframes ai-status-spin {
    from {
        transform: rotate(0deg);
    }

    to {
        transform: rotate(360deg);
    }
}

#ai-status-text {
    font-size: 13px;
    font-weight: 750;
    color: #334155;
    letter-spacing: .1px;
}

#ai-status.ai-working {
    background:
        linear-gradient(
            90deg,
            #eef2ff,
            #f5f3ff
        );
}

#ai-status.ai-working
#ai-status-text {
    color: #4f46e5;
}

#ai-status.ai-success {
    background:
        linear-gradient(
            90deg,
            #f0fdf4,
            #ecfdf5
        );
}

#ai-status.ai-success
#ai-status-text {
    color: #15803d;
}

#ai-status.ai-error {
    background:
        linear-gradient(
            90deg,
            #fff1f2,
            #fff7ed
        );
}

#ai-status.ai-error
#ai-status-text {
    color: #be123c;
}

/* API 设置 */

#ai-settings {
    position: absolute;
    top: 68px;
    left: 14px;
    right: 14px;
    z-index: 50;
    padding: 15px;
    border-radius: 15px;
    background:
        rgba(255,255,255,.985);
    border:
        1px solid #e2e8f0;
    box-shadow:
        0 15px 40px
        rgba(15,23,42,.18);
    display: none;
}

#ai-question {
    position: absolute;
    top: 68px;
    left: 14px;
    right: 14px;
    z-index: 50;
    padding: 15px;
    border-radius: 15px;
    background: rgba(255,255,255,.985);
    border: 1px solid #e2e8f0;
    box-shadow: 0 15px 40px rgba(15,23,42,.18);
    display: none;
}

.ai-question-title {
    font-size: 14px;
    font-weight: 750;
    margin-bottom: 10px;
    color: #1e293b;
}

#ai-question-input {
    width: 100%;
    min-height: 82px;
    box-sizing: border-box;
    resize: vertical;
    padding: 9px 10px;
    border-radius: 8px;
    border: 1px solid #dbe2ea;
    outline: none;
    font: inherit;
    font-size: 12px;
}

#ai-question-input:focus {
    border-color: #60a5fa;
    box-shadow: 0 0 0 3px rgba(59,130,246,.10);
}

.ai-question-actions {
    display: flex;
    justify-content: flex-end;
    gap: 7px;
    margin-top: 10px;
}

.ai-question-actions button {
    padding: 7px 11px;
    font-size: 12px;
}

.ai-question-cancel {
    background: #f1f5f9;
    color: #475569;
}

.ai-question-submit {
    color: white;
    background: linear-gradient(135deg, #2563eb, #4f46e5);
}

.ai-question-new {
    background: #eef2ff;
    color: #4338ca;
}

.ai-setting-title {
    font-size: 14px;
    font-weight: 750;
    margin-bottom: 13px;
    color: #1e293b;
}

#ai-settings label {
    display: block;
    font-size: 11px;
    color: #64748b;
    font-weight: 650;
    margin-top: 8px;
    margin-bottom: 4px;
}

#ai-settings input {
    width: 100%;
    box-sizing: border-box;
    padding: 8px 10px;
    border-radius: 8px;
    border:
        1px solid #dbe2ea;
    outline: none;
    font-size: 12px;
}

#ai-settings input:focus {
    border-color: #818cf8;
    box-shadow:
        0 0 0 3px
        rgba(99,102,241,.10);
}

.ai-setting-actions {
    display: flex;
    justify-content: flex-end;
    gap: 7px;
    margin-top: 13px;
}

.ai-save {
    padding: 7px 11px;
    background:
        linear-gradient(
            135deg,
            #6366f1,
            #8b5cf6
        );
    color: white;
}

.ai-cancel {
    padding: 7px 11px;
    background: #f1f5f9;
    color: #475569;
}
`;

    document.documentElement
        .appendChild(style);

    // =========================================================
    // 创建界面
    // =========================================================

    const container =
        document.createElement('div');

    container.id =
        'ai-translator-container';

    container.innerHTML = `
<div id="ai-translator-panel">

    <div class="ai-header">

        <div class="ai-logo">
            A
        </div>

        <div class="ai-header-text">

            <div class="ai-title">
                中英智能助手
            </div>

            <div class="ai-subtitle">
                TRANSLATION · SENTENCE ANALYSIS
            </div>

        </div>

        <button
            class="ai-question-btn"
            id="ai-question-btn"
            title="提问英语问题"
            aria-label="提问英语问题"
        >
            ?
        </button>

        <button
            class="ai-settings-btn"
            id="ai-settings-btn"
        >
            ⚙ 设置
        </button>

    </div>

    <div class="ai-toolbar">

        <button
            class="ai-btn-translate"
            id="ai-translate"
            title="中英互译"
        >
            ↔
        </button>

        <div class="ai-menu" id="ai-sentence-menu">
            <button class="ai-btn-quick" title="句子分析">⚡</button>
            <div class="ai-submenu">
                <button id="ai-quick-analysis">⚡ 快速分析</button>
                <button id="ai-analysis">◈ 详细分析</button>
            </div>
        </div>

        <div class="ai-menu" id="ai-article-menu">
            <button class="ai-btn-analysis" title="文章分析">📚</button>
            <div class="ai-submenu">
                <button id="ai-article-quick">📝 文章快析</button>
                <button id="ai-article-analysis">📚 文章详析</button>
            </div>
        </div>

        <button
            class="ai-btn-paste"
            id="ai-paste"
            title="读取剪贴板"
        >
            📋
        </button>

        <button
            class="ai-btn-copy"
            id="ai-copy"
            title="复制结果"
        >
            ⧉
        </button>

        <button
            class="ai-btn-clear"
            id="ai-clear"
            title="清空"
        >
            ×
        </button>

    </div>

    <div id="ai-content">

        <div class="ai-card">

            <div class="ai-label">

                <span
                    class="ai-dot
                    ai-dot-purple"
                ></span>

                使用说明

            </div>

            <div class="ai-text">单击悬浮球打开，再单击关闭。
选中中文或英文后点击 ↔ 翻译。
↔ 中英互译
⚡ 快速分析
◈ 详细分析
📝 文章快析（先读取剪贴板）
📚 文章详析（先读取剪贴板）
📋 读取剪贴板</div>

        </div>

    </div>

    <div id="ai-status">

        <span
            class="ai-status-indicator"
        >

            <span
                id="ai-status-icon"
                class="ai-status-dot"
            ></span>

        </span>

        <span id="ai-status-text">
            准备就绪
        </span>

    </div>

    <div id="ai-question">
        <div class="ai-question-title">？ 英语提问</div>
        <textarea id="ai-question-input" placeholder="例如：What is the difference between say and tell?"></textarea>
        <div class="ai-question-actions">
            <button class="ai-question-new" id="ai-question-new">新建对话</button>
            <button class="ai-question-cancel" id="ai-question-cancel">取消</button>
            <button class="ai-question-submit" id="ai-question-submit">发送问题</button>
        </div>
    </div>

    <div id="ai-settings">

        <div class="ai-setting-title">
            ⚙ API 设置
        </div>

        <label>
            API Key
        </label>

        <input
            id="ai-api-key"
            type="password"
            placeholder="请输入 API Key"
        >

        <label>
            Base URL
        </label>

        <input
            id="ai-base-url"
            type="text"
        >

        <label>
            模型
        </label>

        <input
            id="ai-model"
            type="text"
        >

        <div class="ai-setting-actions">

            <button
                class="ai-cancel"
                id="ai-cancel"
            >
                取消
            </button>

            <button
                class="ai-save"
                id="ai-save"
            >
                保存设置
            </button>

        </div>

    </div>

</div>

<div id="ai-translator-ball">

    <div class="ai-ball-inner">

        <svg
            class="ai-ball-icon"
            viewBox="0 0 24 24"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
        >

            <path
                d="M4 5H14M9 3V5M6 8C7.3 10.3 9.2 12.2 12 13.5M11 8C10 11.6 7.7 14.3 4.5 16"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
            />

            <path
                d="M15 19L18 11L21 19M16.1 16H19.9"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
            />

        </svg>

    </div>

</div>
`;

    (
        document.body ||
        document.documentElement
    ).appendChild(
        container
    );

    // =========================================================
    // 获取 DOM
    // =========================================================

    const ball =
        document.getElementById(
            'ai-translator-ball'
        );

    const panel =
        document.getElementById(
            'ai-translator-panel'
        );

    const content =
        document.getElementById(
            'ai-content'
        );

    const statusBox =
        document.getElementById(
            'ai-status'
        );

    const statusText =
        document.getElementById(
            'ai-status-text'
        );

    const statusIcon =
        document.getElementById(
            'ai-status-icon'
        );

    const settingsPanel =
        document.getElementById(
            'ai-settings'
        );

    const questionPanel =
        document.getElementById(
            'ai-question'
        );

    const resizeHandle = document.createElement('div');
    resizeHandle.id = 'ai-resize-handle';
    resizeHandle.title = '拖动调整面板高度';
    panel.appendChild(resizeHandle);

    // =========================================================
    // 状态系统
    // =========================================================

    function setStatus(
        text,
        type = 'ready'
    ) {
        statusText.textContent =
            text;

        statusBox
            .classList
            .remove(
                'ai-working',
                'ai-success',
                'ai-error'
            );

        statusIcon
            .removeAttribute(
                'style'
            );

        if (
            type === 'working'
        ) {
            statusBox
                .classList
                .add(
                    'ai-working'
                );

            statusIcon.className =
                'ai-status-spinner';

            return;
        }

        statusIcon.className =
            'ai-status-dot';

        if (
            type === 'success'
        ) {
            statusBox
                .classList
                .add(
                    'ai-success'
                );

            statusIcon.style.background =
                '#22c55e';

            statusIcon.style.boxShadow =
                '0 0 0 4px rgba(34,197,94,.14)';

            return;
        }

        if (
            type === 'error'
        ) {
            statusBox
                .classList
                .add(
                    'ai-error'
                );

            statusIcon.style.background =
                '#ef4444';

            statusIcon.style.boxShadow =
                '0 0 0 4px rgba(239,68,68,.14)';

            return;
        }

        statusIcon.style.background =
            '#22c55e';

        statusIcon.style.boxShadow =
            '0 0 0 4px rgba(34,197,94,.14)';
    }

    // =========================================================
    // 悬浮球位置
    // =========================================================

    const savedX =
        GM_getValue(
            'translator_ball_x',
            window.innerWidth - 75
        );

    const savedY =
        GM_getValue(
            'translator_ball_y',
            Math.round(
                window.innerHeight * 0.35
            )
        );

    function setContainerPosition(
        x,
        y
    ) {
        const maxX =
            window.innerWidth -
            BALL_SIZE;

        const maxY =
            window.innerHeight -
            BALL_SIZE;

        x =
            Math.max(
                0,
                Math.min(
                    Number(x) || 0,
                    maxX
                )
            );

        y =
            Math.max(
                0,
                Math.min(
                    Number(y) || 0,
                    maxY
                )
            );

        container.style.left =
            x + 'px';

        container.style.top =
            y + 'px';

        container.style.right =
            'auto';

        return {
            x,
            y
        };
    }

    setContainerPosition(
        savedX,
        savedY
    );

    // =========================================================
    // 面板展开方向
    // =========================================================

    function updatePanelDirection() {
        const rect =
            ball
                .getBoundingClientRect();

        if (
            rect.left >
            PANEL_WIDTH + 25
        ) {
            panel.style.right =
                '56px';

            panel.style.left =
                'auto';
        } else {
            panel.style.left =
                '56px';

            panel.style.right =
                'auto';
        }

        const panelHeight =
            panel.getBoundingClientRect().height ||
            Math.min(
                window.innerHeight * 0.5,
                560
            );

        if (
            rect.top +
            panelHeight >
            window.innerHeight
        ) {
            panel.style.top =
                'auto';

            panel.style.bottom =
                '0';
        } else {
            panel.style.top =
                '0';

            panel.style.bottom =
                'auto';
        }
    }

    // =========================================================
    // 面板开关
    // =========================================================

    function openPanel() {
        updatePanelDirection();

        container
            .classList
            .add(
                'ai-open'
            );

        panelOpen = true;
    }

    function closePanel() {
        settingsPanel
            .style
            .display =
                'none';

        questionPanel.style.display = 'none';

        container
            .classList
            .remove(
                'ai-open'
            );

        panelOpen = false;
    }

    function togglePanel() {
        if (panelOpen) {
            closePanel();
        } else {
            openPanel();
        }
    }

    // =========================================================
    // 拖动悬浮球
    // =========================================================

    let dragging = false;
    let moved = false;

    let startMouseX = 0;
    let startMouseY = 0;

    let startX = 0;
    let startY = 0;

    ball.addEventListener(
        'mousedown',
        event => {

            if (
                event.button !== 0
            ) {
                return;
            }

            dragging = true;
            moved = false;

            startMouseX =
                event.clientX;

            startMouseY =
                event.clientY;

            const rect =
                container
                    .getBoundingClientRect();

            startX = rect.left;
            startY = rect.top;

            // 在悬浮球获得焦点前最后尝试保存页面选区；
            // 浏览器内置 PDF 阅读器可能会在随后清除选区。
            rememberSelection();

            event.preventDefault();
        }
    );

    document.addEventListener(
        'mousemove',
        event => {

            if (!dragging) {
                return;
            }

            const dx =
                event.clientX -
                startMouseX;

            const dy =
                event.clientY -
                startMouseY;

            if (
                Math.abs(dx) > 4 ||
                Math.abs(dy) > 4
            ) {
                moved = true;
            }

            const position =
                setContainerPosition(
                    startX + dx,
                    startY + dy
                );

            updatePanelDirection();

            GM_setValue(
                'translator_ball_x',
                position.x
            );

            GM_setValue(
                'translator_ball_y',
                position.y
            );
        }
    );

    document.addEventListener(
        'mouseup',
        () => {
            dragging = false;
        }
    );

    let resizing = false;
    let resizeStartY = 0;
    let resizeStartHeight = 0;

    resizeHandle.addEventListener('mousedown', event => {
        if (event.button !== 0) return;
        resizing = true;
        resizeStartY = event.clientY;
        resizeStartHeight = panel.getBoundingClientRect().height;
        event.preventDefault();
        event.stopPropagation();
    });

    document.addEventListener('mousemove', event => {
        if (!resizing) return;
        const nextHeight = Math.max(360, Math.min(560, resizeStartHeight + event.clientY - resizeStartY));
        panel.style.height = `${nextHeight}px`;
        updatePanelDirection();
    });

    document.addEventListener('mouseup', () => {
        resizing = false;
    });

    ball.addEventListener(
        'click',
        event => {

            event.stopPropagation();

            if (moved) {
                moved = false;
                return;
            }

            togglePanel();
        }
    );

    function setupMenu(menuId) {
        const menu = document.getElementById(menuId);
        const trigger = menu.querySelector(':scope > button');
        trigger.addEventListener('click', event => {
            event.stopPropagation();
            document.querySelectorAll('.ai-menu.ai-menu-open').forEach(other => {
                if (other !== menu) other.classList.remove('ai-menu-open');
            });
            menu.classList.toggle('ai-menu-open');
        });
        menu.querySelector('.ai-submenu').addEventListener('click', event => event.stopPropagation());
    }

    setupMenu('ai-sentence-menu');
    setupMenu('ai-article-menu');
    document.addEventListener('click', () => {
        document.querySelectorAll('.ai-menu.ai-menu-open').forEach(menu => menu.classList.remove('ai-menu-open'));
    });

    // =========================================================
    // 显示输入预览
    // =========================================================

    function showInputPreview(text) {
        content.innerHTML = '';

        const card =
            document.createElement(
                'div'
            );

        card.className =
            'ai-card ai-card-original';

        card.innerHTML = `
<div class="ai-label">
    <span
        class="ai-dot ai-dot-blue"
    ></span>
    已读取文本
</div>

<div class="ai-text"></div>
`;

        card
            .querySelector(
                '.ai-text'
            )
            .textContent =
            text;

        content
            .appendChild(
                card
            );

        openPanel();
    }

    // =========================================================
    // 显示结果
    // =========================================================

    function showResult(
        original,
        title,
        result
    ) {
        result =
            cleanResult(result);

        lastResult =
            result;

        content.innerHTML =
            '';

        const originalCard =
            document.createElement(
                'div'
            );

        originalCard.className =
            'ai-card ai-card-original';

        originalCard.innerHTML = `
<div class="ai-label">
    <span
        class="ai-dot ai-dot-blue"
    ></span>
    原文
</div>

<div class="ai-text"></div>
`;

        originalCard
            .querySelector(
                '.ai-text'
            )
            .textContent =
            original;

        const resultCard =
            document.createElement(
                'div'
            );

        resultCard.className =
            'ai-card ai-card-result';

        resultCard.innerHTML = `
<div class="ai-label">
    <span
        class="ai-dot ai-dot-purple"
    ></span>

    <span
        class="ai-result-title"
    ></span>
</div>

<div class="ai-text"></div>
`;

        resultCard
            .querySelector(
                '.ai-result-title'
            )
            .textContent =
            title;

        resultCard
            .querySelector(
                '.ai-text'
            )
            .innerHTML =
            formatResult(result);

        content
            .appendChild(
                originalCard
            );

        content
            .appendChild(
                resultCard
            );

        if (title === '英语问题回答') {
            const followup = document.createElement('div');
            followup.className = 'ai-card ai-followup-card';
            followup.innerHTML = '<div class="ai-label">继续追问</div><div class="ai-text">点击标题栏的“？”可继续当前对话，或新建对话。</div>';
            content.appendChild(followup);
        }
    }

    // =========================================================
    // 显示错误
    // =========================================================

    function showError(
        title,
        message
    ) {
        content.innerHTML =
            '';

        const card =
            document.createElement(
                'div'
            );

        card.className =
            'ai-card ai-card-error';

        card.innerHTML = `
<div class="ai-label"></div>
<div class="ai-text"></div>
`;

        card
            .querySelector(
                '.ai-label'
            )
            .textContent =
            title;

        card
            .querySelector(
                '.ai-text'
            )
            .textContent =
            message;

        content
            .appendChild(
                card
            );
    }

    // =========================================================
    // 剪贴板读取
    // =========================================================

    async function readClipboardText() {
        try {
            const text =
                await navigator
                    .clipboard
                    .readText();

            if (!text.trim()) {
                setStatus(
                    '剪贴板中没有文本',
                    'error'
                );

                return '';
            }

            currentText =
                text.trim();

            clipboardTextLoaded = true;

            showInputPreview(
                currentText
            );

            setStatus(
                '已读取剪贴板文本',
                'success'
            );

            return currentText;
        } catch {
            setStatus(
                '无法读取剪贴板，请检查浏览器剪贴板权限',
                'error'
            );

            return '';
        }
    }

    // =========================================================
    // 翻译
    // =========================================================

    async function translate() {
        if (requestBusy) {
            setStatus(
                '当前已有请求正在处理中',
                'working'
            );
            return;
        }

        let text =
            getSelectedText() ||
            lastSelectedText;

        if (!text) {
            text = currentText;
        }

        // 内置 PDF 阅读器的选区通常不暴露给网页脚本。
        // 若用户已按 Ctrl+C，则使用剪贴板作为可靠备用输入。
        if (!text) {
            try {
                const clipboardText =
                    await navigator.clipboard.readText();
                if (clipboardText.trim()) {
                    text = clipboardText.trim();
                    currentText = text;
                    clipboardTextLoaded = true;
                    showInputPreview(text);
                }
            } catch {
                // 剪贴板权限不足时继续显示普通提示。
            }
        }

        if (!text) {
            setStatus(
                'PDF 请先按 Ctrl+C 复制文字，再点击翻译',
                'error'
            );

            openPanel();

            return;
        }

        currentText = text;

        const lang =
            detectLanguage(text);

        if (
            lang !== 'zh' &&
            lang !== 'en'
        ) {
            setStatus(
                '仅支持中文和英文互译',
                'error'
            );

            openPanel();

            return;
        }

        requestBusy = true;

        openPanel();

        setStatus(
            lang === 'zh'
                ? '正在翻译：中文 → 英文…'
                : '正在翻译：英文 → 中文…',
            'working'
        );

        content.innerHTML = `
<div class="ai-card">
    <div class="ai-label">
        正在翻译
    </div>

    <div class="ai-text">
        AI 正在生成翻译结果…
    </div>
</div>
`;

        try {
            const result =
                await requestAPI(
                    translatePrompt(
                        text,
                        lang
                    ),
                    NORMAL_TIMEOUT
                );

            showResult(
                text,
                lang === 'zh'
                    ? '英文翻译'
                    : '中文翻译',
                result
            );

            setStatus(
                '翻译完成',
                'success'
            );
        } catch (error) {
            if (
                error.message ===
                'TIMEOUT'
            ) {
                setStatus(
                    '翻译请求超时',
                    'error'
                );

                showError(
                    '翻译失败',
                    'API 请求超时，请稍后重试。'
                );
            } else {
                setStatus(
                    '请求失败：' +
                    error.message,
                    'error'
                );

                showError(
                    '翻译失败',
                    error.message
                );
            }
        } finally {
            requestBusy = false;
        }
    }

    // =========================================================
    // 快速分析
    // =========================================================

    async function quickAnalyze() {
        if (requestBusy) {
            setStatus(
                '当前已有请求正在处理中',
                'working'
            );
            return;
        }

        let text =
            getSelectedText() ||
            lastSelectedText;

        if (!text) {
            text = currentText;
        }

        if (!text) {
            setStatus(
                '请先选择英文，或点击 📋 读取剪贴板',
                'error'
            );

            openPanel();

            return;
        }

        if (
            detectLanguage(text) !==
            'en'
        ) {
            setStatus(
                '快速分析仅支持英文',
                'error'
            );

            openPanel();

            return;
        }

        currentText = text;
        requestBusy = true;

        openPanel();

        setStatus(
            '正在快速分析句子结构…',
            'working'
        );

        content.innerHTML = `
<div class="ai-card">
    <div class="ai-label">
        快速分析
    </div>

    <div class="ai-text">
        正在提取句子主干、关键结构和翻译…
    </div>
</div>
`;

        try {
            const result =
                await requestAPI(
                    quickPrompt(text),
                    NORMAL_TIMEOUT
                );

            showResult(
                text,
                '快速分析',
                result
            );

            setStatus(
                '快速分析完成',
                'success'
            );
        } catch (error) {
            if (
                error.message ===
                'TIMEOUT'
            ) {
                setStatus(
                    '快速分析请求超时',
                    'error'
                );

                showError(
                    '快速分析失败',
                    'API 请求超时，请稍后重试。'
                );
            } else {
                setStatus(
                    '请求失败：' +
                    error.message,
                    'error'
                );

                showError(
                    '快速分析失败',
                    error.message
                );
            }
        } finally {
            requestBusy = false;
        }
    }

    // =========================================================
    // 详细分析
    // =========================================================

    async function detailedAnalyze() {
        if (requestBusy) {
            setStatus(
                '当前已有请求正在处理中',
                'working'
            );
            return;
        }

        let text =
            getSelectedText() ||
            lastSelectedText;

        if (!text) {
            text = currentText;
        }

        if (!text) {
            setStatus(
                '请先选择英文，或点击 📋 读取剪贴板',
                'error'
            );

            openPanel();

            return;
        }

        if (
            detectLanguage(text) !==
            'en'
        ) {
            setStatus(
                '详细分析仅支持英文',
                'error'
            );

            openPanel();

            return;
        }

        currentText = text;
        requestBusy = true;

        openPanel();

        setStatus(
            '正在详细分析，可能需要一些时间…',
            'working'
        );

        content.innerHTML = `
<div class="ai-card">
    <div class="ai-label">
        详细分析
    </div>

    <div class="ai-text">
        正在分析主干、从句、修饰关系、重点词组和翻译…
    </div>
</div>
`;

        try {
            const result =
                await requestAPI(
                    detailPrompt(text),
                    DETAIL_TIMEOUT
                );

            showResult(
                text,
                '详细分析',
                result
            );

            setStatus(
                '详细分析完成',
                'success'
            );

            requestBusy = false;
            return;
        } catch (error) {
            if (
                error.message !==
                'TIMEOUT'
            ) {
                setStatus(
                    '详细分析失败：' +
                    error.message,
                    'error'
                );

                showError(
                    '详细分析失败',
                    error.message
                );

                requestBusy = false;
                return;
            }
        }

        // 第一次超时，自动精简重试

        setStatus(
            '首次请求超时，正在自动精简重试…',
            'working'
        );

        content.innerHTML = `
<div class="ai-card">
    <div class="ai-label">
        自动重试
    </div>

    <div class="ai-text">
        首次详细分析超时，正在使用更精简的分析方式重新请求…
    </div>
</div>
`;

        try {
            const result =
                await requestAPI(
                    fallbackPrompt(text),
                    DETAIL_TIMEOUT
                );

            showResult(
                text,
                '详细分析（精简重试）',
                result
            );

            setStatus(
                '详细分析完成（重试成功）',
                'success'
            );
        } catch (error) {
            if (
                error.message ===
                'TIMEOUT'
            ) {
                setStatus(
                    '详细分析连续两次超时',
                    'error'
                );

                showError(
                    '详细分析超时',
                    '连续两次 API 请求超时。建议使用 ⚡ 快速分析，或缩短一次选中的英文长度。'
                );
            } else {
                setStatus(
                    '详细分析失败：' +
                    error.message,
                    'error'
                );

                showError(
                    '详细分析失败',
                    error.message
                );
            }
        } finally {
            requestBusy = false;
        }
    }

    async function articleAnalyze(detail = false) {
        if (requestBusy) {
            setStatus('当前已有请求正在处理中', 'working');
            return;
        }

        if (!clipboardTextLoaded || !currentText) {
            setStatus('请先点击 📋 读取剪贴板文章', 'error');
            openPanel();
            return;
        }

        if (detectLanguage(currentText) !== 'en') {
            setStatus('文章分析仅支持英文文章', 'error');
            openPanel();
            return;
        }

        let text = currentText;
        let truncated = false;
        if (text.length > ARTICLE_MAX_CHARS) {
            text = text.slice(0, ARTICLE_MAX_CHARS);
            truncated = true;
        }

        requestBusy = true;
        openPanel();
        setStatus(detail ? '正在详细分析文章结构…' : '正在快速分析文章结构…', 'working');
        content.innerHTML = `<div class="ai-card"><div class="ai-label">${detail ? '文章详析' : '文章快析'}</div><div class="ai-text">正在分析文章主题、段落结构和逻辑关系…</div></div>`;

        try {
            const result = await requestAPI(
                detail ? articleDetailPrompt(text) : articleQuickPrompt(text),
                detail ? DETAIL_TIMEOUT : NORMAL_TIMEOUT
            );
            showResult(text, detail ? '文章详细分析' : '文章快速分析', result);
            setStatus(truncated ? '分析完成（文章过长，已截取前 30000 个字符）' : '文章分析完成', 'success');
            if (truncated) {
                const notice = document.createElement('div');
                notice.className = 'ai-card ai-card-error';
                notice.textContent = '提示：原文章超过 30000 个字符，本次仅分析了开头部分。';
                content.insertBefore(notice, content.firstChild);
            }
        } catch (error) {
            setStatus('文章分析失败：' + error.message, 'error');
            showError('文章分析失败', error.message === 'TIMEOUT' ? 'API 请求超时，请缩短文章后重试。' : error.message);
        } finally {
            requestBusy = false;
        }
    }

    async function askQuestion() {
        if (requestBusy) {
            setStatus('当前已有请求正在处理中', 'working');
            return;
        }

        const input = document.getElementById('ai-question-input');
        const question = input.value.trim();
        if (!question) {
            setStatus('请输入英语问题', 'error');
            input.focus();
            return;
        }

        requestBusy = true;
        questionPanel.style.display = 'none';
        openPanel();
        setStatus('正在回答英语问题…', 'working');
        content.innerHTML = '<div class="ai-card"><div class="ai-label">英语提问</div><div class="ai-text">正在思考并生成回答…</div></div>';

        try {
            const result = await requestAPI(conversationPrompt(questionHistory, question), NORMAL_TIMEOUT);
            questionHistory.push({ question, answer: result });
            if (questionHistory.length > MAX_QUESTION_TURNS) {
                questionHistory = questionHistory.slice(-MAX_QUESTION_TURNS);
            }
            showResult(question, '英语问题回答', result);
            setStatus('回答完成', 'success');
            input.value = '';
        } catch (error) {
            setStatus('提问失败：' + error.message, 'error');
            showError('提问失败', error.message);
        } finally {
            requestBusy = false;
        }
    }

    // =========================================================
    // API 设置
    // =========================================================

    document
        .getElementById(
            'ai-settings-btn'
        )
        .addEventListener(
            'click',
            event => {

                event.stopPropagation();

                const config =
                    getConfig();

                document
                    .getElementById(
                        'ai-api-key'
                    )
                    .value =
                    config.apiKey;

                document
                    .getElementById(
                        'ai-base-url'
                    )
                    .value =
                    config.baseUrl;

                document
                    .getElementById(
                        'ai-model'
                    )
                    .value =
                    config.model;

                settingsPanel
                    .style
                    .display =
                    'block';

                questionPanel.style.display = 'none';

                openPanel();
            }
        );

    document
        .getElementById(
            'ai-cancel'
        )
        .addEventListener(
            'click',
            () => {
                settingsPanel
                    .style
                    .display =
                    'none';
            }
        );

    document
        .getElementById(
            'ai-save'
        )
        .addEventListener(
            'click',
            () => {

                const apiKey =
                    document
                        .getElementById(
                            'ai-api-key'
                        )
                        .value;

                const baseUrl =
                    document
                        .getElementById(
                            'ai-base-url'
                        )
                        .value;

                const model =
                    document
                        .getElementById(
                            'ai-model'
                        )
                        .value;

                if (!apiKey.trim()) {
                    setStatus(
                        'API Key 不能为空',
                        'error'
                    );
                    return;
                }

                saveConfig(
                    apiKey,
                    baseUrl,
                    model
                );

                settingsPanel
                    .style
                    .display =
                    'none';

                setStatus(
                    'API 设置已保存',
                    'success'
                );
            }
        );

    // =========================================================
    // 按钮
    // =========================================================

    document
        .getElementById(
            'ai-translate'
        )
        .addEventListener(
            'click',
            translate
        );

    document
        .getElementById(
            'ai-quick-analysis'
        )
        .addEventListener(
            'click',
            quickAnalyze
        );

    document
        .getElementById(
            'ai-analysis'
        )
        .addEventListener(
            'click',
            detailedAnalyze
        );

    document.getElementById('ai-question-btn').addEventListener('click', event => {
        event.stopPropagation();
        settingsPanel.style.display = 'none';
        questionPanel.style.display = questionPanel.style.display === 'block' ? 'none' : 'block';
        openPanel();
        if (questionPanel.style.display === 'block') {
            document.querySelector('.ai-question-title').textContent = questionHistory.length ? `？ 继续追问（已进行 ${questionHistory.length} 轮）` : '？ 英语提问';
            document.getElementById('ai-question-input').focus();
        }
    });

    document.getElementById('ai-question-new').addEventListener('click', () => {
        questionHistory = [];
        document.getElementById('ai-question-input').value = '';
        document.querySelector('.ai-question-title').textContent = '？ 英语提问';
        setStatus('已新建英语对话', 'success');
    });

    document.getElementById('ai-question-cancel').addEventListener('click', () => {
        questionPanel.style.display = 'none';
    });

    document.getElementById('ai-question-submit').addEventListener('click', askQuestion);
    document.getElementById('ai-question-input').addEventListener('keydown', event => {
        if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') {
            event.preventDefault();
            askQuestion();
        }
    });

    document.getElementById('ai-article-quick').addEventListener('click', () => articleAnalyze(false));
    document.getElementById('ai-article-analysis').addEventListener('click', () => articleAnalyze(true));

    document
        .getElementById(
            'ai-paste'
        )
        .addEventListener(
            'click',
            readClipboardText
        );

    // =========================================================
    // 复制结果
    // =========================================================

    document
        .getElementById(
            'ai-copy'
        )
        .addEventListener(
            'click',
            async () => {

                if (!lastResult) {
                    setStatus(
                        '当前没有结果可复制',
                        'error'
                    );

                    return;
                }

                try {
                    await navigator
                        .clipboard
                        .writeText(
                            lastResult
                        );

                    setStatus(
                        '已复制到剪贴板',
                        'success'
                    );
                } catch {
                    const textarea =
                        document
                            .createElement(
                                'textarea'
                            );

                    textarea.value =
                        lastResult;

                    textarea.style.position =
                        'fixed';

                    textarea.style.left =
                        '-9999px';

                    textarea.style.top =
                        '-9999px';

                    (
                        document.body ||
                        document.documentElement
                    ).appendChild(
                        textarea
                    );

                    textarea.focus();
                    textarea.select();

                    try {
                        const success =
                            document.execCommand(
                                'copy'
                            );

                        if (success) {
                            setStatus(
                                '已复制到剪贴板',
                                'success'
                            );
                        } else {
                            setStatus(
                                '复制失败，请手动复制',
                                'error'
                            );
                        }
                    } catch {
                        setStatus(
                            '复制失败，请手动复制',
                            'error'
                        );
                    }

                    textarea.remove();
                }
            }
        );

    // =========================================================
    // 清空
    // =========================================================

    document
        .getElementById(
            'ai-clear'
        )
        .addEventListener(
            'click',
            () => {

                currentText = '';
                lastResult = '';
                lastSelectedText = '';
                clipboardTextLoaded = false;
                questionHistory = [];
                document.getElementById('ai-question-input').value = '';

                content.innerHTML = `
<div class="ai-card">

    <div class="ai-label">
        已清空
    </div>

    <div class="ai-text">
        选择中文或英文后点击 ↔ 开始翻译。
    </div>

</div>
`;

                setStatus(
                    '准备就绪',
                    'ready'
                );
            }
        );

    // =========================================================
    // 窗口变化
    // =========================================================

    window.addEventListener(
        'resize',
        () => {

            const rect =
                container
                    .getBoundingClientRect();

            const position =
                setContainerPosition(
                    rect.left,
                    rect.top
                );

            GM_setValue(
                'translator_ball_x',
                position.x
            );

            GM_setValue(
                'translator_ball_y',
                position.y
            );

            if (panelOpen) {
                updatePanelDirection();
            }
        }
    );

    // =========================================================
    // 初始化
    // =========================================================

    setStatus(
        '准备就绪',
        'ready'
    );

})();
